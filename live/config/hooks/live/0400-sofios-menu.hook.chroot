#!/bin/bash
# Menu SofiOS: nomi italiani senza la K, programmi tecnici nascosti (non cancellati)
D=/usr/share/applications
O=/usr/local/share/applications
mkdir -p "$O"

rinomina() {  # file-pattern  nuovo-nome  [icona]
  for f in $D/$1; do
    [ -f "$f" ] || continue
    b=$(basename "$f")
    grep -v -E '^(Name|GenericName|Comment)(\[[^]]*\])?=' "$f" > "$O/$b"
    # il Name va subito dopo [Desktop Entry]
    sed -i "0,/^\[Desktop Entry\]/s//[Desktop Entry]\nName=$2/" "$O/$b"
    if [ -n "$3" ]; then sed -i -e "/^Icon=/d" "$O/$b"; sed -i "0,/^Name=/s//Icon=$3\nName=/" "$O/$b"; fi
  done
}
nascondi() {
  for f in $D/$1; do
    [ -f "$f" ] || continue
    b=$(basename "$f")
    printf '[Desktop Entry]\nType=Application\nName=%s\nNoDisplay=true\nHidden=true\n' "$b" > "$O/$b"
  done
}

rinomina 'org.kde.dolphin.desktop' 'File' sofios-file
rinomina 'org.kde.konsole.desktop' 'Terminale' sofios-terminale
rinomina 'org.kde.kwrite.desktop' 'Editor di testo' sofios-editor
rinomina 'org.kde.kcalc.desktop' 'Calcolatrice' sofios-calcolatrice
rinomina 'org.kde.spectacle.desktop' 'Schermate' sofios-schermate
rinomina 'org.kde.okular.desktop' 'Lettore PDF' sofios-pdf
rinomina 'org.kde.gwenview.desktop' 'Foto' sofios-foto
rinomina 'org.kde.ark.desktop' 'Archivi' sofios-archivi
rinomina 'org.kde.kdeconnect*.desktop' 'Collega telefono' sofios-telefono
rinomina 'org.kde.discover.desktop' 'SoStore' sofios-store
rinomina 'org.kde.partitionmanager.desktop' 'Dischi' sofios-dischi
rinomina 'systemsettings.desktop' 'Impostazioni' sofios-impostazioni
rinomina 'org.kde.systemsettings.desktop' 'Impostazioni' sofios-impostazioni
rinomina 'firefox-esr.desktop' 'Browser' sofios-browser
rinomina 'libreoffice-writer.desktop' 'Scrittura' sofios-scrittura
rinomina 'libreoffice-calc.desktop' 'Fogli' sofios-fogli
rinomina 'vlc.desktop' 'Video' sofios-video
rinomina 'thunderbird.desktop' 'Mail' sofios-mail
rinomina 'org.mozilla.Thunderbird.desktop' 'Mail' sofios-mail
rinomina 'org.kde.kfind.desktop' 'Cerca file' sofios-cerca
rinomina 'org.kde.kup*.desktop' 'Backup' sofios-backup
rinomina 'org.kde.plasma-systemmonitor.desktop' 'Monitor di sistema' sofios-monitor

nascondi 'org.kde.plasma-welcome.desktop'
nascondi 'org.kde.kinfocenter.desktop'
nascondi 'kcm_about-distro.desktop'
nascondi 'org.kde.kate.desktop'
nascondi 'org.kde.konqueror.desktop'
nascondi 'org.kde.khelpcenter.desktop'
nascondi 'org.kde.kmenuedit.desktop'
nascondi 'org.kde.kwalletmanager*.desktop'
nascondi 'libreoffice-math.desktop'
nascondi 'vim.desktop'
nascondi 'gvim.desktop'
nascondi 'org.kde.plasma.vault*.desktop'
nascondi 'org.kde.plasma.thunderbolt*.desktop'
nascondi 'org.kde.plasma.firewall*.desktop'
nascondi 'org.kde.kdeconnect.sms.desktop'
nascondi 'org.kde.kdeconnect.nonplasma.desktop'
nascondi 'org.kde.kdeconnect-settings.desktop'
nascondi 'libreoffice-startcenter.desktop'
nascondi 'org.kde.drkonqi.coredump.gui.desktop'
nascondi 'system-config-printer.desktop'
# tema "Debian" (dal pacchetto desktop-base) fuori dall'elenco dei temi
rm -rf /usr/share/plasma/look-and-feel/org.debian.desktop
printf '[Icons]\nTheme=SofiOS\n' >> /etc/xdg/kdeglobals
gtk-update-icon-cache -f /usr/share/icons/hicolor 2>/dev/null || true
update-desktop-database "$O" 2>/dev/null || true
exit 0
