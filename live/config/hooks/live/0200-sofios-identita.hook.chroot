#!/bin/sh
# Nome SofiOS al posto di Debian dove l'utente lo vede
set -e
# /usr/lib/os-release e' di base-files: lo "deviamo" cosi' un aggiornamento di Debian non rimette il nome Debian
if [ -e /usr/lib/os-release ] && ! dpkg-divert --list /usr/lib/os-release | grep -q os-release; then
  dpkg-divert --local --rename --divert /usr/lib/os-release.debian --add /usr/lib/os-release || true
fi
[ -e /etc/os-release ] && [ ! -L /etc/os-release ] && rm -f /etc/os-release
[ -e /usr/lib/os-release ] || touch /usr/lib/os-release
ln -sf ../usr/lib/os-release /etc/os-release
cat > /usr/lib/os-release <<'OSR'
PRETTY_NAME="SofiOS"
NAME="SofiOS"
VERSION="1.0"
VERSION_ID="1.0"
ID=sofios
ID_LIKE=debian
HOME_URL="https://github.com/Asdrubale1234/sofios"
LOGO=sofios-logo
OSR
echo "SofiOS" > /etc/issue
echo "SofiOS" > /etc/issue.net
echo "sofios" > /etc/hostname
# Cartelle dell'utente gia' pronte (in italiano)
for d in Scrivania Scaricati Modelli Pubblici Documenti Musica Immagini Video; do mkdir -p "/etc/skel/$d"; done

# Tema SofiOS come predefinito di Plasma
mkdir -p /etc/xdg
kwriteconfig6 --file /etc/xdg/kdeglobals --group KDE --key LookAndFeelPackage org.sofios.desktop 2>/dev/null || \
 printf '[KDE]\nLookAndFeelPackage=org.sofios.desktop\n' >> /etc/xdg/kdeglobals
# "Impostazioni rapide" propone due temi (chiaro e scuro): entrambi SofiOS, cosi' un clic non riporta l'aspetto di KDE
for k in DefaultLightLookAndFeel DefaultDarkLookAndFeel; do
  kwriteconfig6 --file /etc/xdg/kdeglobals --group KDE --key "$k" org.sofios.desktop 2>/dev/null || \
   printf '[KDE]\n%s=org.sofios.desktop\n' "$k" >> /etc/xdg/kdeglobals
done

# Menu Aiuto di tutti i programmi: niente "Informazioni su KDE", segnala bug, donazioni, manuali KDE
printf '\n[KDE Action Restrictions]\naction/help_about_kde=false\naction/help_about_app=false\naction/help_report_bug=false\naction/help_donate=false\naction/help_contents=false\naction/switch_application_language=false\n' >> /etc/xdg/kdeglobals

# "Informazioni su questo sistema" di KDE (mostra Plasma/Qt): tolto da Impostazioni; c'e' "Informazioni su SofiOS" (nostra)
kwriteconfig6 --file /etc/xdg/kdeglobals --group "KDE Control Module Restrictions" --key kcm_about-distro false 2>/dev/null || \
 printf '\n[KDE Control Module Restrictions]\nkcm_about-distro=false\n' >> /etc/xdg/kdeglobals
# "KDE Connect" nelle Impostazioni: il telefono si collega dall'app "Collega telefono"
kwriteconfig6 --file /etc/xdg/kdeglobals --group "KDE Control Module Restrictions" --key kcm_kdeconnect false 2>/dev/null || \
 printf 'kcm_kdeconnect=false\n' >> /etc/xdg/kdeglobals
echo "SOFIOS: kdeglobals:"; cat /etc/xdg/kdeglobals

# Niente portafogli KDE per tutti gli utenti
mkdir -p /etc/xdg
printf '[Wallet]\nEnabled=false\nFirst Use=false\n' > /etc/xdg/kwalletrc
# Schermata di avvio SofiOS (Plymouth)
if command -v plymouth-set-default-theme >/dev/null 2>&1; then
  plymouth-set-default-theme -R sofios || true
fi
# Prova da chiavetta: niente blocco schermo (servizio attivo solo con boot=live)
systemctl enable sofios-live-impostazioni.service 2>/dev/null || \
  { mkdir -p /etc/systemd/system/multi-user.target.wants; ln -sf /etc/systemd/system/sofios-live-impostazioni.service /etc/systemd/system/multi-user.target.wants/sofios-live-impostazioni.service; }
# SOLO PROVA: rapporto sul desktop via porta seriale (solo macchina virtuale), da togliere nella ISO ufficiale
systemctl enable sofios-diag-seriale.service 2>/dev/null || \
  { mkdir -p /etc/systemd/system/graphical.target.wants; ln -sf /etc/systemd/system/sofios-diag-seriale.service /etc/systemd/system/graphical.target.wants/sofios-diag-seriale.service; }
echo "SOFIOS: diag-seriale abilitato? $(systemctl is-enabled sofios-diag-seriale.service 2>&1)"
echo "SOFIOS: sorgenti apt nell'immagine:"; cat /etc/apt/sources.list 2>/dev/null || true; cat /etc/apt/sources.list.d/* 2>/dev/null || true; echo "SOFIOS: unattended-upgrades: $(dpkg -s unattended-upgrades 2>&1 | head -1)"
# Elenco dei file con il simbolo Debian (per il registro: cosa resta da cambiare)
echo "== SOFIOS: file con marchio Debian (avatar, loghi) =="
find /usr/share /var/lib/AccountsService -iname '*debian*' \( -name '*.png' -o -name '*.svg' -o -name '*.icon' \) 2>/dev/null | head -40
find /usr/share/sddm/faces -type f 2>/dev/null || true
exit 0
