#!/bin/sh
# Installatore: marchio SofiOS e nessun obbligo di internet
set -e
S=/etc/calamares/settings.conf
if [ -f "$S" ]; then
  sed -i 's/^branding:.*/branding: sofios/' "$S"
else
  echo "ATTENZIONE: $S non trovato"
fi
W=/etc/calamares/modules/welcome.conf
if [ -f "$W" ]; then
  sed -i '/^ *- *internet *$/d' "$W"
  sed -i 's/^\( *\)internet:.*/\1internet: false/' "$W" || true
fi
# Icona e nome "Installa SofiOS" per il lanciatore
for f in $(grep -ril calamares /usr/share/applications 2>/dev/null); do
  sed -i 's/^Name=.*/Name=Installa SofiOS/;s/^Name\[[^]]*\]=.*/Name[it]=Installa SofiOS/;s#^Icon=.*#Icon=/usr/share/sofios/logo.png#' "$f"
  sed -i '/^GenericName\(\[[^]]*\]\)\?=/d;/^Comment\(\[[^]]*\]\)\?=/d' "$f"
  sed -i '0,/^Name=/s//Comment=Installa SofiOS sul computer\nName=/' "$f"
done
# Partizioni: niente cifratura del disco nell'installer (scelta di Luca); il resto resta com'e'
echo "SOFIOS: moduli Calamares in /etc e /usr/share:"; ls /etc/calamares/modules /usr/share/calamares/modules 2>&1 | head -80
# Se il pacchetto non mette i file in /etc, partiamo dagli esempi di /usr/share (Calamares usa prima /etc)
for f in partition mount; do
  if [ ! -f /etc/calamares/modules/$f.conf ] && [ -f /usr/share/calamares/modules/$f.conf ]; then
    mkdir -p /etc/calamares/modules; cp /usr/share/calamares/modules/$f.conf /etc/calamares/modules/$f.conf
    echo "SOFIOS: copiato $f.conf da /usr/share"
  fi
done
P=/etc/calamares/modules/partition.conf
if [ -f "$P" ]; then
  sed -i '/^enableLuksAutomatedPartitioning:/d' "$P"
  [ -n "$(tail -c1 "$P")" ] && echo >> "$P"
  echo 'enableLuksAutomatedPartitioning: false' >> "$P"
  echo "SOFIOS: partition.conf (righe attive):"; grep -v -E '^\s*(#|$)' "$P" | head -40
else
  echo "ATTENZIONE: $P non trovato"
fi
# Disco: btrfs come predefinito, con sottovolumi separati per sistema (@) e file personali (@home), cosi le istantanee
# ripristinano solo il sistema. Scelta di Luca (7 novembre 2026).
if [ -f "$P" ]; then
  sed -i '/^defaultFileSystemType:/d' "$P"
  echo 'defaultFileSystemType: "btrfs"' >> "$P"
  echo "SOFIOS: filesystem predefinito e disponibili:"; grep -n -E '^(defaultFileSystemType|availableFileSystemTypes)' "$P"
fi
M=/etc/calamares/modules/mount.conf
if [ -f "$M" ]; then
  if grep -q '^btrfsSubvolumes:' "$M" && grep -q '/@home' "$M"; then
    echo "SOFIOS: mount.conf ha gia i sottovolumi @ e @home"
  elif ! grep -q '^btrfsSubvolumes:' "$M"; then
    printf 'btrfsSubvolumes:\n    - mountPoint: /\n      subvolume: /@\n    - mountPoint: /home\n      subvolume: /@home\n    - mountPoint: /var/log\n      subvolume: /@log\n    - mountPoint: /var/cache\n      subvolume: /@cache\n' >> "$M"
  else
    echo "ATTENZIONE: mount.conf ha btrfsSubvolumes diversi, da controllare"
  fi
  echo "SOFIOS: mount.conf (righe attive):"; grep -v -E '^\s*(#|$)' "$M" | head -40
else
  echo "ATTENZIONE: $M non trovato"
fi
exit 0
