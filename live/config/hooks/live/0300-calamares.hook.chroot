#!/bin/sh
# Installatore: marchio SofiOS e nessun obbligo di internet
set -e
S=/etc/calamares/settings.conf
if [ -f "$S" ]; then
  sed -i 's/^branding:.*/branding: sofios/' "$S"
else
  echo "ATTENZIONE: $S non trovato"
fi
# Livelli di installazione (Essenziale / Completo / Completo + Android): pagina di scelta dopo la tastiera, applicati dopo la copia dei file
if [ -f "$S" ]; then
  python3 - "$S" <<'PY'
import sys
p = sys.argv[1]; r = open(p).read().split("\n"); out = []; vista = False; exec_ = False; tast = False
for riga in r:
    out.append(riga)
    if riga.strip() == "- keyboard" and not tast and not exec_:
        out.append(riga.replace("- keyboard", "- packagechooser@livelli")); tast = True
    if riga.strip() == "- exec:": exec_ = True
    if exec_ and riga.strip() == "- packages" and not vista:
        out.append(riga.replace("- packages", "- contextualprocess")); vista = True
t = "\n".join(out).rstrip("\n") + "\ninstances:\n- id: livelli\n  module: packagechooser\n  config: livelli.conf\n"
open(p, "w").write(t)
PY
  echo "SOFIOS: sequenza installatore:"; sed -n '/^sequence/,$p' "$S" | head -60
fi
W=/etc/calamares/modules/welcome.conf
if [ -f "$W" ]; then
  sed -i '/^ *- *internet *$/d' "$W"
  sed -i 's/^\( *\)internet:.*/\1internet: false/' "$W" || true
fi
# Icona e nome "Installa SofiOS" per il lanciatore
for f in $(grep -ril calamares /usr/share/applications 2>/dev/null); do
  sed -i 's/^Name=.*/Name=Installa SofiOS/;s/^Name\[[^]]*\]=.*/Name[it]=Installa SofiOS/;s#^Icon=.*#Icon=/usr/share/sofios/logo.png#' "$f"
  sed -i '/^GenericName\(\[[^]]*\]\)\?=/d;/^Comment\(\[[^]]*\]\)\?=/d' "$f"
  sed -i '0,/^Name=/s//Comment=Installa SofiOS sul computer\nName=/' "$f"
done
# Partizioni: scritto da noi per intero (il pacchetto non lo mette in /etc). Niente cifratura del disco (scelta di Luca),
# btrfs predefinito (istantanee), niente swap su partizione/ibernazione (verra usata la memoria compressa zram).
mkdir -p /etc/calamares/modules
cat > /etc/calamares/modules/partition.conf <<'EOF'
---
efiSystemPartition: "/boot/efi"
userSwapChoices:
  - none
  - small
drawNestedPartitions: false
alwaysShowPartitionLabels: true
allowManualPartitioning: true
initialPartitioningChoice: none
initialSwapChoice: none
defaultPartitionTableType: msdos
defaultFileSystemType: "btrfs"
availableFileSystemTypes: ["btrfs", "ext4"]
enableLuksAutomatedPartitioning: false
requiredStorage: 10.0
EOF
echo "SOFIOS: partition.conf scritto:"; cat /etc/calamares/modules/partition.conf
# Accesso: nell'installer resta la casella "Accedi automaticamente senza chiedere la password" (la sceglie l'utente);
# di partenza NON spuntata, cioe' la password viene chiesta.
U=/etc/calamares/modules/users.conf
if [ -f "$U" ]; then
  if grep -q '^ *doAutologin:' "$U"; then sed -i 's/^ *doAutologin:.*/doAutologin:     false/' "$U"; else echo 'doAutologin:     false' >> "$U"; fi
  echo "SOFIOS: users.conf (righe attive):"; grep -v -E '^\s*(#|$)' "$U" | head -30
else
  echo "ATTENZIONE: $U non trovato"
fi
M=/etc/calamares/modules/mount.conf
if [ -f "$M" ]; then
  if grep -q '^btrfsSubvolumes:' "$M" && grep -q '/@home' "$M"; then
    echo "SOFIOS: mount.conf ha gia i sottovolumi @ e @home"
  elif ! grep -q '^btrfsSubvolumes:' "$M"; then
    printf 'btrfsSubvolumes:\n    - mountPoint: /\n      subvolume: /@\n    - mountPoint: /home\n      subvolume: /@home\n    - mountPoint: /var/log\n      subvolume: /@log\n    - mountPoint: /var/cache\n      subvolume: /@cache\n' >> "$M"
  else
    echo "ATTENZIONE: mount.conf ha btrfsSubvolumes diversi, da controllare"
  fi
  echo "SOFIOS: mount.conf (righe attive):"; grep -v -E '^\s*(#|$)' "$M" | head -40
else
  echo "ATTENZIONE: $M non trovato"
fi
exit 0
