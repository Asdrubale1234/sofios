<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Sofi Labs</vendor>
  <action id="org.sofios.android-permessi">
    <description>Concedere a un'app Android i permessi approvati</description>
    <message>Serve la password per concedere i permessi all'app Android</message>
    <icon_name>sofios-store</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/lib/sofios/android-permessi</annotate>
  </action>
</policyconfig>
