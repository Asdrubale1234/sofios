#!/bin/sh
# SofiOS: i temi di icone originali restano come riserva (per le icone che mancano) ma non si possono scegliere dalle Impostazioni.
for t in breeze breeze-dark Breeze_Light Adwaita; do
  f=/usr/share/icons/$t/index.theme
  [ -f "$f" ] || continue
  grep -q '^Hidden=' "$f" && sed -i 's/^Hidden=.*/Hidden=true/' "$f" || sed -i '0,/^\[Icon Theme\]/s//[Icon Theme]\nHidden=true/' "$f"
done
exit 0
