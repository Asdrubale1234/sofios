#!/bin/sh
# SoStore: operazioni su Android che richiedono i permessi di amministratore (chiamato con pkexec)
#   android-attiva VANILLA|GAPPS   scarica e prepara Android (senza Google / con Google Play)
#   android-attiva id-google       stampa il codice del computer per la registrazione su Google
set -e
avvia_sessione() {
  U="${PKEXEC_UID:-$SUDO_UID}"
  [ -n "$U" ] && [ "$U" != "0" ] || return 0
  N=$(id -nu "$U")
  runuser -u "$N" -- env XDG_RUNTIME_DIR="/run/user/$U" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$U/bus" WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" \
    sh -c 'waydroid session start >/dev/null 2>&1 &' || true
}
case "$1" in
  VANILLA|GAPPS)
    echo "Preparo Android ($1)…"
    # supporto di Android nel kernel (modulo "binder"), caricato ora e a ogni avvio
    echo "binder_linux" > /etc/modules-load.d/sofios-android.conf
    echo "options binder_linux devices=binder,hwbinder,vndbinder" > /etc/modprobe.d/sofios-android.conf
    modprobe binder_linux devices=binder,hwbinder,vndbinder 2>&1 || echo "binder non caricato"
    if [ -f /var/lib/waydroid/waydroid.cfg ]; then
      systemctl stop waydroid-container.service 2>/dev/null || true
      waydroid init -f -s "$1"
    else
      waydroid init -s "$1"
    fi
    systemctl enable --now waydroid-container.service
    # la sessione di Android parte come utente che ha chiesto l'operazione, poi togliamo le app gia' presenti
    # la sessione di Android parte come utente che ha chiesto l'operazione, poi si pulisce e si configura
    avvia_sessione
    "$0" pulisci || echo "pulizia non riuscita"
    echo "Android pronto."
    ;;
  pulisci)
    # toglie le app che Android porta con se' (messaggi, calendario, galleria, musica, fotocamera...):
    # restano solo quelle che servono (impostazioni, Google Play se scelto, selettore file)
    LOG=/var/log/sofios-android-pulizia.log; : > "$LOG"
    i=0
    while [ $i -lt 90 ]; do
      [ "$(waydroid shell -- getprop sys.boot_completed 2>/dev/null | tr -d '\r\n ')" = "1" ] && break
      i=$((i+1)); sleep 3
    done
    echo "avvio atteso: $i giri" >> "$LOG"
    # app che Android porta con se' (verificate sull'immagine di Waydroid): tutte tolte.
    # restano solo impostazioni, selettore file e tastiera, che servono al funzionamento.
    TOGLIERE="com.android.contacts org.lineageos.recorder com.android.gallery3d org.lineageos.jelly org.lineageos.eleven org.lineageos.etar org.lineageos.aperture com.android.calculator2 com.android.deskclock com.android.messaging com.android.dialer com.android.music org.lineageos.updater org.lineageos.backgrounds"
    for p in $TOGLIERE; do
      waydroid shell -- pm path "$p" 2>/dev/null | grep -q package || continue
      echo "tolgo $p: $(waydroid shell -- pm uninstall -k --user 0 "$p" 2>&1 | tr -d '\r')" >> "$LOG"
      for H in /home/*; do rm -f "$H/.local/share/applications/waydroid.$p.desktop" 2>/dev/null; done
    done
    waydroid shell -- pm list packages -s 2>/dev/null | tr -d '\r' | grep -E "contacts|gallery|jelly|eleven|etar|aperture|calculator|deskclock|recorder" >> "$LOG" || echo "rimaste: nessuna delle app tolte" >> "$LOG"
    # le app di Android si aprono come finestre normali del desktop (come un programma Linux),
    # in italiano, e con la tastiera del computer (niente tastiera a schermo di Android)
    waydroid prop set persist.waydroid.multi_windows true >> "$LOG" 2>&1
    waydroid prop set persist.sys.language it >> "$LOG" 2>&1; waydroid prop set persist.sys.country IT >> "$LOG" 2>&1; waydroid prop set persist.sys.locale it-IT >> "$LOG" 2>&1
    waydroid shell -- settings put secure show_ime_with_hard_keyboard 0 >> "$LOG" 2>&1
    echo "tastiera a schermo: $(waydroid shell -- settings get secure show_ime_with_hard_keyboard 2>&1 | tr -d '\r')" >> "$LOG"
    # riavvio della sessione perche' le impostazioni valgano subito
    waydroid session stop >> "$LOG" 2>&1 || true
    sleep 5
    avvia_sessione
    cat "$LOG"
    ;;
  id-google)
    waydroid shell -- sh -c "sqlite3 /data/data/com.google.android.gsf/databases/gservices.db \"select value from main where name = 'android_id';\""
    ;;
  *) echo "uso: android-attiva VANILLA|GAPPS|id-google|pulisci" >&2; exit 2 ;;
esac
