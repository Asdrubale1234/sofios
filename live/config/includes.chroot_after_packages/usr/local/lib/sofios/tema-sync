#!/bin/sh
# SofiOS: quando si cambia tema (chiaro/scuro) cambia anche lo sfondo, così cambia tutto insieme.
tema=$(kreadconfig6 --file kdeglobals --group KDE --key LookAndFeelPackage 2>/dev/null)
[ -n "$tema" ] || exit 0
stato="${XDG_CACHE_HOME:-$HOME/.cache}/sofios-tema"
# al primo avvio il tema scelto è già quello applicato: lo registro e basta (applicarlo mentre la sessione parte faceva andare in crash lo strumento)
if [ ! -f "$stato" ]; then mkdir -p "$(dirname "$stato")"; echo "$tema" > "$stato"; exit 0; fi
[ "$(cat "$stato" 2>/dev/null)" = "$tema" ] && exit 0
# senza la barra di Plasma già attiva non c'è niente da ricaricare
pgrep -x plasmashell >/dev/null 2>&1 || exit 0
case "$tema" in
  org.sofios.desktop) img=/usr/share/wallpapers/SofiOSArgento/contents/images/3840x2160.png; barre=breeze-light ;;
  org.sofios.graphite) img=/usr/share/wallpapers/SofiOSGrafite/contents/images/3840x2160.png; barre=breeze-dark ;;
  org.sofios.gold) img=/usr/share/wallpapers/SofiOSOro/contents/images/3840x2160.png; barre=breeze-light ;;
  *) exit 0 ;;
esac
# le barre si ricaricano davvero solo se il tema cambia: passo da un altro e poi torno
altro=default; [ "$barre" = default ] && altro=breeze-dark
plasma-apply-desktoptheme "$altro" >/dev/null 2>&1; sleep 1
plasma-apply-desktoptheme "$barre" >/dev/null 2>&1
plasma-apply-wallpaperimage "$img" >/dev/null 2>&1 && { mkdir -p "$(dirname "$stato")"; echo "$tema" > "$stato"; }
exit 0
