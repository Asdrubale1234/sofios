#!/bin/sh
# SOLO PROVA (macchina virtuale): prove di SoStore con risultati sulla porta seriale. Da togliere nella ISO ufficiale.
S() { sudo tee /dev/ttyS0 > /dev/null; }
case "$1" in
  kernel)
    { echo "### kernel-android"; ls -l /dev/binder* /dev/binderfs 2>&1; uname -r
      grep -i -E 'ANDROID_BINDER|BINDERFS' /boot/config-* 2>&1 | head; command -v waydroid; waydroid --version 2>&1; dpkg -l waydroid 2>&1 | tail -1; } 2>&1 | S ;;
  windows)
    echo "### windows-store" | S; SOFIOS_FOTO=/tmp/win.png SOFIOS_WINDOWS_FOTO=win-notepadplusplus sofios-store 2>&1 | S ;;
  windows-log)
    { echo "### windows-registro"; cat ~/.cache/sofios-store/windows/ultimo.log; ls ~/.wine/drive_c/Program* ~/.wine/drive_c/Program*/Notepad++ | head -30; } 2>&1 | S ;;
  windows-apri)
    wine "$HOME/.wine/drive_c/Program Files/Notepad++/notepad++.exe" ;;
  android-attiva)
    # nella prova la memoria e' poca: Android va sul disco virtuale
    { sudo mkfs.ext4 -q -F /dev/vdb && sudo mkdir -p /var/lib/waydroid && sudo mount /dev/vdb /var/lib/waydroid && df -h /var/lib/waydroid; } 2>&1 | S
    sudo /usr/local/lib/sofios/android-attiva VANILLA 2>&1 | S ;;
  android-stato)
    { echo "### android-stato"; waydroid status; systemctl is-active waydroid-container; journalctl -u waydroid-container --no-pager | tail -20; lsmod | grep -i binder; ls -l /dev/binder* /dev/binderfs 2>&1; dmesg 2>&1 | grep -i -E "binder|waydroid|lxc" | tail -10; } 2>&1 | S ;;
  android-avvio)
    waydroid session start & sleep 40; waydroid show-full-ui ;;
  android-app)
    echo "### android-app" | S; SOFIOS_FOTO=/tmp/and.png SOFIOS_ANDROID_FOTO=1 SOFIOS_ANDROID_INSTALLA=app.organicmaps sofios-store 2>&1 | S ;;
  android-lista)
    { echo "### android-lista"; waydroid app list; echo "--- pulizia:"; cat /var/log/sofios-android-pulizia.log 2>&1; echo "--- cartelle di menu:"; ls -R ~/.config/menus ~/.local/share/desktop-directories 2>&1 | head -30; cat ~/.config/menus/applications-merged/*.menu 2>/dev/null | head -30; grep -H -E "^(Name|Categories|Exec)=" ~/.local/share/applications/*.desktop ~/.local/share/applications/wine/Programs/*.desktop 2>/dev/null | head -20; echo "--- windows menu:"; ls -R ~/.local/share/applications 2>&1 | head -40; ls -la ~/.cache/sofios-store/android/apk 2>&1; echo "--- registro installazione:"; cat ~/.cache/sofios-store/android/ultimo.log 2>&1; echo "--- pacchetti android:"; sudo waydroid shell -- pm list packages 2>&1 | grep -i -E "organic|vending" ; echo "--- spazio android:"; sudo waydroid shell -- df -h /data 2>&1 | tail -3; echo "--- installa a mano:"; waydroid app install ~/.cache/sofios-store/android/apk/app.organicmaps.apk 2>&1 | tail -5; sleep 10; sudo waydroid shell -- pm list packages 2>&1 | grep -i organic; echo "--- logcat:"; sudo waydroid shell -- logcat -d 2>&1 | grep -i -E "PackageInstaller|INSTALL_FAILED|insufficient|DeviceStorage|app.organicmaps" | tail -15; echo "--- app list ora:"; waydroid app list 2>&1 | grep -i -E "Name|packageName" | head -8; } 2>&1 | S ;;
  android-apri)
    waydroid app launch app.organicmaps ;;
  android-lingua)
    { echo "### android-lingua"; waydroid prop set persist.sys.language it; waydroid prop set persist.sys.country IT; waydroid prop set persist.sys.locale it-IT
      waydroid session stop; sleep 5; waydroid session start & sleep 40; waydroid show-full-ui; } 2>&1 | S ;;
  collaudo)
    { echo "### collaudo-inizio"
      F() { echo "COLLAUDO-FALLITO: $*"; }
      for u in $(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}'); do F "servizio in errore: $u"; done
      for d in /usr/share/applications/*.desktop; do
        [ -f /usr/local/share/applications/$(basename $d) ] && d=/usr/local/share/applications/$(basename $d)
        grep -qE '^(NoDisplay|Hidden)=true' "$d" && continue
        n=$(grep -m1 '^Name=' "$d" | cut -d= -f2-); e=$(grep -m1 '^Exec=' "$d" | cut -d= -f2- | awk '{print $1}')
        [ -n "$e" ] && ! command -v "$e" >/dev/null 2>&1 && [ ! -x "$e" ] && F "voce di menu '$n' ($(basename $d)): il comando '$e' non esiste"
        echo "$n" | grep -qiE 'debian|kde|plasma|wine|waydroid|calamares|kubuntu' && F "marchio visibile nel menu: '$n' ($(basename $d))"
      done
      for b in sofios-info sofios-note sofios-password sofios-benvenuto sofios-aggiorna-finestra sofios-store; do
        out=$(QT_QPA_PLATFORM=offscreen timeout 12 $b 2>&1 >/dev/null); rc=$?
        echo "$out" | grep -qE 'Traceback|Error|ModuleNotFound' && F "$b: errore all'avvio: $(echo "$out" | grep -E 'Error|Traceback' | head -2 | tr '\n' ' ')"
        [ $rc -ne 0 ] && [ $rc -ne 124 ] && F "$b: si è chiuso da solo con codice $rc"
      done
      fc-list | grep -qi 'Inter' || F "font Inter non installato"
      locale 2>/dev/null | grep -q 'LANG=it' || F "lingua di sistema non italiana: $(locale | head -1)"
      [ "$(cat /etc/hostname)" = "sofios" ] || echo "NOTA hostname: $(cat /etc/hostname)"
      grep -qi debian /etc/os-release && grep -iE '^(NAME|PRETTY_NAME)=.*debian' /etc/os-release | while read r; do F "os-release mostra Debian: $r"; done
      command -v snapper >/dev/null || F "snapper non presente"
      command -v ufw >/dev/null && { ufw status 2>/dev/null | grep -q active || echo "NOTA firewall non attivo nella prova"; }
      b=$(grep -m1 -oE 'branding: *\w+' /etc/calamares/settings.conf | awk '{print $2}'); grep -qiE 'debian|kde' /etc/calamares/branding/$b/branding.desc && F "marchio nel tema dell'installer ($b)"
      journalctl -b -p 3 --no-pager 2>/dev/null | grep -vE 'binder|vdb|ttyS0|drm|firmware|evolution-source-registry' | tail -15 | while read r; do echo "COLLAUDO-LOG-ERRORE: $r"; done
      echo "### collaudo-fine"; } 2>&1 | S ;;
  collaudo-duro)
    { echo "### collaudo-duro-inizio"
      F() { echo "COLLAUDO-FALLITO: $*"; }
      dpkg --audit 2>&1 | head -5 | while read r; do F "pacchetti a metà: $r"; done
      sudo apt-get check 2>&1 | grep -qiE 'unmet|broken|E:' && F "dipendenze rotte (apt-get check)"
      for u in /etc/systemd/system/sofios*.service /usr/lib/systemd/system/sofios*.service; do [ -f "$u" ] && systemd-analyze verify "$u" 2>&1 | grep -v '^$' | head -2 | while read r; do F "unità systemd: $r"; done; done
      echo "NOTA avvio: $(systemd-analyze 2>&1 | head -1)"
      for b in sofios-info sofios-note sofios-password sofios-benvenuto sofios-store; do
        mx=0
        for i in 1 2 3 4 5 6 7 8; do
          QT_QPA_PLATFORM=offscreen $b >/dev/null 2>/tmp/e.$$ & pid=$!; sleep 4
          if kill -0 $pid 2>/dev/null; then r=$(awk '/VmRSS/{print $2}' /proc/$pid/status 2>/dev/null); [ "${r:-0}" -gt "$mx" ] && mx=${r:-0}; kill $pid 2>/dev/null
          else wait $pid; rc=$?; F "$b: al tentativo $i si è chiuso da solo (codice $rc) $(tail -1 /tmp/e.$$)"; fi
          wait $pid 2>/dev/null
        done
        echo "NOTA memoria $b: ${mx} kB"; [ "$mx" -gt 600000 ] && F "$b usa troppa memoria (${mx} kB)"
      done
      # SoStore con cartelle di cache mancanti / rete assente / lingua diversa
      QT_QPA_PLATFORM=offscreen HOME=/tmp/vuoto timeout 10 sofios-store 2>&1 | grep -E 'Traceback|Error' | head -2 | while read r; do F "SoStore con profilo vuoto: $r"; done
      QT_QPA_PLATFORM=offscreen LANG=en_US.UTF-8 timeout 10 sofios-info 2>&1 | grep -E 'Traceback|Error' | head -2 | while read r; do F "sofios-info con altra lingua: $r"; done
      coredumpctl list --no-pager 2>/dev/null | tail -5 | while read r; do echo "$r" | grep -q 'No coredumps' || F "programma andato in crash: $r"; done
      dmesg 2>/dev/null | grep -iE 'out of memory|oom-kill|segfault|general protection|call trace' | head -5 | while read r; do F "kernel: $r"; done
      df -h / 2>/dev/null | tail -1 | awk '{gsub("%","",$5); if ($5+0>90) print "COLLAUDO-FALLITO: disco quasi pieno: "$5"%"}'
      echo "### collaudo-duro-fine"; } 2>&1 | S ;;
  *) echo "uso: sofios-prova-store kernel|windows|windows-log|windows-apri|android-attiva|android-stato|android-avvio" ;;
esac
