#!/usr/bin/python3
# Note di SofiOS: un file di testo per nota nella cartella "Note" della tua casa. Salvataggio automatico.
import os, sys, time
sys.path.insert(0, "/usr/local/lib/sofios")
import tema_app
import luma
from sofios_info import bottone_informazioni
from PyQt6.QtCore import Qt, QTimer
from PyQt6.QtGui import QIcon
from PyQt6.QtWidgets import (QApplication, QWidget, QListWidget, QListWidgetItem, QPlainTextEdit,
                             QPushButton, QHBoxLayout, QVBoxLayout, QLabel, QMessageBox)

import glob, shutil
import cartella_sofios as CS
CARTELLA = CS.NOTE
LOGO = os.environ.get("SOFIOS_LOGO", "/usr/share/sofios/logo.png")
STILE = """
QWidget#finestra { background: #0b2740; }
QLabel#titolo { color: #ffffff; font-size: 18px; font-weight: 700; }
QListWidget { background: #12365a; border: none; border-radius: 12px; color: #e6f1ff; font-size: 13px; padding: 6px; outline: 0; }
QListWidget::item { padding: 9px 10px; border-radius: 8px; }
QListWidget::item:selected { background: #1e6fa8; color: #ffffff; }
QPlainTextEdit { background: #12365a; border: none; border-radius: 12px; color: #e6f1ff; font-size: 14px; padding: 14px; selection-background-color: #1e6fa8; }
QPushButton { background: #ffd479; color: #0b2740; border: none; border-radius: 10px; padding: 9px 16px; font-size: 13px; font-weight: 700; }
QPushButton:hover { background: #ffe19e; }
QPushButton#vuoto { background: #1e6fa8; color: #ffffff; font-weight: 600; }
"""

def titolo_di(testo, nome):
    riga = next((r.strip() for r in testo.splitlines() if r.strip()), "")
    return riga[:48] if riga else "Nota vuota"

class Note(QWidget):
    def __init__(self):
        super().__init__()
        self.setObjectName("finestra"); self.setWindowTitle("Note"); self.setWindowIcon(QIcon(LOGO))
        self.setStyleSheet(tema_app.adatta(STILE)); self.resize(860, 560)
        os.makedirs(CARTELLA, exist_ok=True)
        self.corrente = None; self.salvato = None
        radice = QHBoxLayout(self); radice.setContentsMargins(20, 18, 20, 18); radice.setSpacing(16)
        sx = QVBoxLayout(); sx.setSpacing(10)
        t = QLabel("Note"); t.setObjectName("titolo"); sx.addWidget(t)
        self.elenco = QListWidget(); self.elenco.setFixedWidth(250); sx.addWidget(self.elenco, 1)
        nuova = QPushButton("Nuova nota"); nuova.clicked.connect(self.nuova); sx.addWidget(nuova)
        cancella = QPushButton("Elimina nota"); cancella.setObjectName("vuoto"); cancella.clicked.connect(self.elimina); sx.addWidget(cancella)
        sx.addWidget(bottone_informazioni(self, "Note", "Le tue note, salvate da sole nella cartella Note."))
        radice.addLayout(sx)
        self.testo = QPlainTextEdit(); self.testo.setPlaceholderText("Scrivi qui la tua nota…")
        dx = QVBoxLayout(); dx.setSpacing(10)
        self.avviso = QWidget(); self.avviso.setObjectName("scheda"); av = QVBoxLayout(self.avviso); av.setContentsMargins(14, 10, 14, 10)
        self.avviso_t = QLabel(""); self.avviso_t.setWordWrap(True); av.addWidget(self.avviso_t)
        rb = QHBoxLayout()
        for testo, azione in (("Tieni questa", self.tieni_questa), ("Tieni l'altra", self.tieni_altra), ("Tieni tutte e due", self.tieni_entrambe)):
            b = QPushButton(testo); b.clicked.connect(azione); rb.addWidget(b)
        av.addLayout(rb); self.avviso.hide(); dx.addWidget(self.avviso)
        self.vuota = QWidget(); hv = QHBoxLayout(self.vuota); hv.setContentsMargins(0, 0, 0, 0); hv.setSpacing(14)
        hv.addWidget(luma.etichetta("note")); tv = QLabel("Nessuna nota qui.\nScrivi la prima: si salva da sola."); tv.setObjectName("sottotitolo"); hv.addWidget(tv, 1)
        dx.addWidget(self.vuota); dx.addWidget(self.testo, 1)
        self.testo.textChanged.connect(lambda: self.vuota.setVisible(not self.testo.toPlainText().strip()))
        radice.addLayout(dx, 1)
        self.salva_t = QTimer(self); self.salva_t.setSingleShot(True); self.salva_t.setInterval(600); self.salva_t.timeout.connect(self.salva)
        self.testo.textChanged.connect(self.salva_t.start)
        self.elenco.currentItemChanged.connect(self.apri)
        self.carica()
        if self.elenco.count() == 0: self.nuova()

    def percorsi(self):
        f = [os.path.join(CARTELLA, n) for n in os.listdir(CARTELLA) if n.endswith(".txt") and ".sync-conflict-" not in n]
        return sorted(f, key=os.path.getmtime, reverse=True)

    def carica(self, scegli=None):
        self.elenco.blockSignals(True); self.elenco.clear()
        for p in self.percorsi():
            try: tx = open(p, encoding="utf-8").read()
            except OSError: continue
            it = QListWidgetItem(titolo_di(tx, p)); it.setData(Qt.ItemDataRole.UserRole, p); self.elenco.addItem(it)
        self.elenco.blockSignals(False)
        if self.elenco.count():
            riga = 0
            for i in range(self.elenco.count()):
                if self.elenco.item(i).data(Qt.ItemDataRole.UserRole) == scegli: riga = i
            self.elenco.setCurrentRow(riga); self.apri(self.elenco.currentItem(), None)

    def apri(self, it, _):
        if it is None: return
        self.salva()
        self.corrente = it.data(Qt.ItemDataRole.UserRole)
        try: self.salvato = open(self.corrente, encoding="utf-8").read()
        except OSError: self.salvato = ""
        self.testo.blockSignals(True); self.testo.setPlainText(self.salvato); self.testo.blockSignals(False)
        self.controlla_conflitto()

    # ---- due versioni della stessa nota (modificata su due dispositivi senza rete) ----
    def conflitti_di(self, percorso):
        base = os.path.basename(percorso)[:-4]
        return sorted(glob.glob(os.path.join(CARTELLA, base + ".sync-conflict-*.txt")))

    def controlla_conflitto(self):
        self.altra = None
        if self.corrente:
            c = self.conflitti_di(self.corrente)
            if c: self.altra = c[0]
        if not self.altra: self.avviso.hide(); return
        try: altro = open(self.altra, encoding="utf-8").read()
        except OSError: self.avviso.hide(); return
        anteprima = " ".join(altro.split())[:160]
        self.avviso_t.setText("Ci sono due versioni di questa nota. L'altra dice: «%s…»" % anteprima); self.avviso.show()

    def _metti_da_parte(self, percorso):
        d = os.path.join(CARTELLA, ".conflitti"); os.makedirs(d, exist_ok=True)
        dest = os.path.join(d, os.path.basename(percorso)); n = 1
        while os.path.exists(dest): dest = os.path.join(d, "%d-%s" % (n, os.path.basename(percorso))); n += 1
        shutil.move(percorso, dest)

    def tieni_questa(self):
        if self.altra: self._metti_da_parte(self.altra)
        self.controlla_conflitto()

    def tieni_altra(self):
        if not self.altra: return
        self.salva()
        try:
            nuovo = open(self.altra, encoding="utf-8").read()
            vecchia = self.corrente + ".questa-versione"; shutil.copy2(self.corrente, vecchia); self._metti_da_parte(vecchia)
            with open(self.corrente + ".tmp", "w", encoding="utf-8") as f: f.write(nuovo)
            os.replace(self.corrente + ".tmp", self.corrente); self._metti_da_parte(self.altra)
        except OSError:
            QMessageBox.warning(self, "Note", "Non riesco a cambiare la nota."); return
        self.carica(scegli=self.corrente)

    def tieni_entrambe(self):
        if not self.altra: return
        self.salva(); base = time.strftime("nota-%Y%m%d-%H%M%S"); n = 1
        while True:
            dest = os.path.join(CARTELLA, base + ("" if n == 1 else "-%d" % n) + ".txt")
            if not os.path.exists(dest): break
            n += 1
        try: os.replace(self.altra, dest)
        except OSError: QMessageBox.warning(self, "Note", "Non riesco a tenere tutte e due."); return
        self.carica(scegli=self.corrente)

    def voce_di(self, percorso):
        for i in range(self.elenco.count()):
            if self.elenco.item(i).data(Qt.ItemDataRole.UserRole) == percorso: return self.elenco.item(i)
        return None

    def salva(self):
        """Salva solo se il testo e' cambiato (cosi' l'ordine delle note non cambia solo guardandole).
        Scrive prima in un file temporaneo e poi lo sostituisce: se il computer si spegne a meta', la nota resta intera."""
        self.salva_t.stop()
        if not self.corrente: return
        testo = self.testo.toPlainText()
        if testo == getattr(self, "salvato", None): return
        tmp = self.corrente + ".tmp"
        try:
            with open(tmp, "w", encoding="utf-8") as f: f.write(testo); f.flush(); os.fsync(f.fileno())
            os.replace(tmp, self.corrente)
        except OSError:
            QMessageBox.warning(self, "Note", "Non riesco a salvare la nota. Controlla che il disco non sia pieno."); return
        self.salvato = testo
        it = self.voce_di(self.corrente)
        if it: it.setText(titolo_di(testo, self.corrente))

    def nuova(self):
        self.salva()
        if self.corrente and not self.testo.toPlainText().strip():   # c'e' gia' una nota vuota: si usa quella
            self.testo.setFocus(); return
        base = time.strftime("nota-%Y%m%d-%H%M%S"); n = 1; p = None
        while p is None:   # nome sempre nuovo: due note nello stesso secondo non si sovrascrivono
            prova = os.path.join(CARTELLA, base + ("" if n == 1 else "-%d" % n) + ".txt")
            try: open(prova, "x", encoding="utf-8").close(); p = prova
            except FileExistsError: n += 1
            except OSError:
                QMessageBox.warning(self, "Note", "Non riesco a creare la nota."); return
        self.carica(scegli=p); self.testo.setFocus()

    def elimina(self):
        if not self.corrente: return
        if QMessageBox.question(self, "Elimina nota", "Vuoi eliminare questa nota?") == QMessageBox.StandardButton.Yes:
            try: os.remove(self.corrente)
            except OSError: pass
            self.corrente = None; self.salvato = None; self.carica()
            if self.elenco.count() == 0: self.nuova()

    def closeEvent(self, e):
        self.salva(); e.accept()

def main():
    app = QApplication(sys.argv); app.setApplicationName("Note"); app.setDesktopFileName("sofios-note")
    messaggio = CS.migra()      # copia le note di prima nella cartella SofiOS (mai sposta, mai cancella)
    w = Note()
    if os.environ.get("SOFIOS_FOTO"):
        w.show(); app.processEvents(); w.grab().save(os.environ["SOFIOS_FOTO"]); return 0
    w.show()
    if messaggio: QTimer.singleShot(500, lambda: QMessageBox.information(w, "Note", messaggio))
    return app.exec()
if __name__ == "__main__": sys.exit(main())
