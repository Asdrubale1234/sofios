#!/bin/sh
# SOLO PROVA (macchina virtuale): scrive nella porta seriale lo stato del desktop, per le schermate di prova. Da togliere nella ISO ufficiale.
[ -w /dev/ttyS0 ] || exit 0
U=live; N=$(id -u $U 2>/dev/null) || exit 0
rapporto() {
  echo "=== RAPPORTO $1 $(date +%T) virt=$(systemd-detect-virt) uid=$N ==="
  echo "--- sessioni"; loginctl list-sessions --no-legend 2>&1
  echo "--- pannelli"
  runuser -u $U -- env XDG_RUNTIME_DIR=/run/user/$N DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$N/bus \
    busctl --user call org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell evaluateScript s 'print(panels().length)' 2>&1
  echo "--- look and feel"; grep -H LookAndFeel /etc/xdg/kdeglobals /home/$U/.config/kdeglobals 2>&1
  ls /usr/share/plasma/look-and-feel/ 2>&1
  echo "--- config live"; ls -la /home/$U/.config 2>&1 | head -40
  echo "--- appletsrc"
  grep -E '^\[Containments\]\[[0-9]+\]$|^plugin=|^location=|^formfactor=|^lastScreen=' /home/$U/.config/plasma-org.kde.plasma.desktop-appletsrc 2>&1 | head -60
  echo "--- sofios-pannelli"; cat /home/$U/.cache/sofios-pannelli.log 2>&1
  echo "--- blocco schermo"; cat /etc/xdg/kscreenlockerrc 2>&1; systemctl is-active sofios-live-impostazioni 2>&1
  echo "--- journal plasmashell"
  journalctl -b --no-pager 2>&1 | grep -iE 'plasmashell|plasma-shell|org.kde.plasma|layout|appletsrc|kwin_wayland.*(error|fail)' | tail -70
  echo "=== FINE RAPPORTO $1 ==="
}
for T in 70 90 150 120; do
  sleep $T; rapporto "+$T" > /dev/ttyS0 2>&1
done
exit 0
