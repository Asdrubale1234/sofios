#!/usr/bin/python3
"""SoStore: il negozio di programmi di SofiOS.
Vetrina scelta da noi (catalogo.json, aggiornato con gli aggiornamenti firmati) + ricerca in tutto il catalogo.
Installa / apre / rimuove con PackageKit (pkcon): la password la chiede il sistema."""
import json, os, re, shlex, subprocess, sys, glob
sys.path.insert(0, os.environ.get("SOFIOS_LIB", "/usr/local/lib/sofios"))
from sofios_info import bottone_informazioni
from PyQt6.QtCore import Qt, QProcess, QSize, QTimer
from PyQt6.QtGui import QIcon
from PyQt6.QtWidgets import (QApplication, QWidget, QVBoxLayout, QHBoxLayout, QLabel, QPushButton, QLineEdit,
                             QStackedWidget, QScrollArea, QGridLayout, QProgressBar, QFrame, QMessageBox)

LOGO = os.environ.get("SOFIOS_LOGO", "/usr/share/sofios/logo.png")
CATALOGI = [os.environ.get("SOFIOS_CATALOGO", ""), "/var/lib/sofios/store/catalogo.json", "/usr/share/sofios/store/catalogo.json"]
CARTELLE_ICONE = ["/var/lib/swcatalog/icons", "/usr/share/swcatalog/icons", "/var/lib/app-info/icons", "/usr/share/app-info/icons"]

