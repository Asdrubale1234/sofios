ELENCO_MIEI = os.path.join(os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")), "sofios-store", "installati.json")
CACHE_ICONE = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "sofios-store", "icone")
CARTELLE_ICONE = ["/var/lib/swcatalog/icons", "/usr/share/swcatalog/icons", "/var/lib/app-info/icons", "/usr/share/app-info/icons"]

