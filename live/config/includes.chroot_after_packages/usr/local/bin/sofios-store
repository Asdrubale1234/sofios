# ---------------------------------------------------------------- dati
def carica_catalogo():
    for p in CATALOGI:
        if p and os.path.exists(p):
            try:
                with open(p, encoding="utf-8") as f: return json.load(f)
            except Exception: pass
    return {"vetrina": []}

def leggi_miei():
    try:
        with open(ELENCO_MIEI, encoding="utf-8") as f: return json.load(f)
    except Exception: return {}

def segna_mio(app, si):
    """ricorda i programmi installati da SoStore (anche quelli fuori vetrina) per la pagina Installati"""
    d = leggi_miei()
    if si: d[app["pacchetto"]] = {k: app.get(k) for k in ("pacchetto", "nome", "descrizione", "icona", "desktop") if app.get(k)}
    else: d.pop(app["pacchetto"], None)
    try:
        os.makedirs(os.path.dirname(ELENCO_MIEI), exist_ok=True)
        with open(ELENCO_MIEI + ".tmp", "w", encoding="utf-8") as f: json.dump(d, f, ensure_ascii=False, indent=1)
        os.replace(ELENCO_MIEI + ".tmp", ELENCO_MIEI)
    except OSError: pass

def installato(pacchetto):
    try:
        r = subprocess.run(["dpkg-query", "-W", "-f=${db:Status-Status}", pacchetto], capture_output=True, text=True, timeout=10)
        return r.stdout.strip() == "installed"
    except Exception:
        return False

def file_desktop(pacchetto, desktop_id=None):
    """il lanciatore (.desktop) del programma: dal nome indicato o dai file del pacchetto"""
    cand = []
    if desktop_id:
        cand += ["/usr/local/share/applications/" + desktop_id, "/usr/share/applications/" + desktop_id]
    try:
        r = subprocess.run(["dpkg-query", "-L", pacchetto], capture_output=True, text=True, timeout=10)
        for l in r.stdout.splitlines():
            if l.startswith("/usr/share/applications/") and l.endswith(".desktop"):
                cand += ["/usr/local/share/applications/" + os.path.basename(l), l]
    except Exception: pass
    for c in cand:
        if os.path.exists(c):
            try:
                t = open(c, encoding="utf-8").read()
                if re.search(r"(?m)^NoDisplay\s*=\s*true", t) and c == cand[-1]: continue
                return c
            except OSError: pass
    return None

def apri_programma(desktop):
    try:
        t = open(desktop, encoding="utf-8").read()
        m = re.search(r"(?m)^Exec\s*=\s*(.+)$", t)
        if not m: return False
        cmd = re.sub(r"%[a-zA-Z]", "", m.group(1)).strip()
        args = shlex.split(cmd)
        return QProcess.startDetached(args[0], args[1:])[0]
    except Exception:
        return False

def pulisci(html):
    t = " ".join(html.split()); t = re.sub(r"</p>|<br\s*/?>", "\n\n", t); t = re.sub(r"<li>", "\n• ", t); t = re.sub(r"<[^>]+>", "", t)
    righe = [" ".join(r.split()) for r in t.split("\n")]
    return re.sub(r"\n{3,}", "\n\n", "\n".join(righe)).strip()

_TAR = {}
def icona_da_archivio(nome):
    """icone del catalogo scaricate da apt come archivi (…icons-128x128.tar.gz): estrae solo quella che serve"""
    if not nome or "/" in nome: return None
    f = os.path.join(CACHE_ICONE, "archivio_" + nome)
    if os.path.exists(f): return f
    for arch in sorted(glob.glob("/var/lib/apt/lists/*icons-128x128*.tar.gz")) + sorted(glob.glob("/var/lib/apt/lists/*icons-64x64.tar.gz")):
        try:
            if arch not in _TAR:
                t = tarfile.open(arch); _TAR[arch] = (t, set(t.getnames()))
            t, nomi = _TAR[arch]
            if nome in nomi:
                dati = t.extractfile(nome).read()
                os.makedirs(CACHE_ICONE, exist_ok=True); open(f, "wb").write(dati); return f
        except Exception:
            continue
    return None

def icona_da_nome(nome, grandezza=64):
    if not nome: return QIcon.fromTheme("application-x-executable")
    if os.path.isabs(nome) and os.path.exists(nome): return QIcon(nome)
    i = QIcon.fromTheme(nome)
    if not i.isNull(): return i
    for base in CARTELLE_ICONE:   # icone del catalogo (scaricate con le liste dei pacchetti)
        for g in ("128x128", "64x64", "48x48"):
            for f in glob.glob(f"{base}/*/{g}/{nome}*.png") + glob.glob(f"{base}/*/{g}/*_{nome}.png"):
                return QIcon(f)
    return QIcon.fromTheme("application-x-executable")

class Catalogo:
    """ricerca in tutto il catalogo dei programmi (AppStream); se non c'e', solo la vetrina"""
    def __init__(self):
        self.pool = None
        try:
            import gi
            gi.require_version("AppStream", "1.0")
            from gi.repository import AppStream
            self.AS = AppStream
            self.pool = AppStream.Pool()
            self.pool.load()
        except Exception as e:
            print("SoStore: catalogo completo non disponibile:", e, file=sys.stderr)
            self.pool = None

    def numero(self):
        if not self.pool: return 0
        try:
            b = self.pool.get_components()
            return b.get_size() if hasattr(b, "get_size") else len(b)
        except Exception: return 0

    def _lista(self, risultato):
        if risultato is None: return []
        if hasattr(risultato, "as_array"): return list(risultato.as_array())
        if hasattr(risultato, "get_size"):
            return [risultato.index_safe(i) for i in range(risultato.get_size())]
        return list(risultato)

    def icona(self, c):
        """file dell'icona: prima quelle grandi scaricate con il catalogo, poi quella del tema"""
        migliore, nome_tema = None, ""
        for ic in c.get_icons() or []:
            k = ic.get_kind()
            if k == self.AS.IconKind.STOCK: nome_tema = ic.get_name()
            elif k in (self.AS.IconKind.REMOTE, self.AS.IconKind.CACHED) and icona_da_archivio(ic.get_name()):
                f = icona_da_archivio(ic.get_name())
                if migliore is None or (ic.get_width() or 0) >= migliore[0] or str(migliore[1]).startswith("http"):
                    migliore = (ic.get_width() or 0, f)
            elif k == self.AS.IconKind.REMOTE and ic.get_url():
                w = ic.get_width() or 0
                if migliore is None or (w > migliore[0] and not str(migliore[1]).startswith("/")):
                    migliore = (w, ic.get_url())
            elif k in (self.AS.IconKind.CACHED, self.AS.IconKind.LOCAL):
                f = ic.get_filename() or ""
                if not f or not os.path.exists(f):
                    nome = ic.get_name() or ""; w = ic.get_width() or 64
                    for base in CARTELLE_ICONE:
                        trovati = glob.glob(f"{base}/*/{w}x{w}/{nome}") or glob.glob(f"{base}/*/{w}x{w}@*/{nome}")
                        if trovati: f = trovati[0]; break
                if f and os.path.exists(f) and (migliore is None or str(migliore[1]).startswith("http") or (ic.get_width() or 0) > migliore[0]):
                    migliore = (ic.get_width() or 0, f)
        return migliore[1] if migliore else nome_tema

    def icone_per_pacchetto(self):
        """pacchetto -> icona, per la vetrina (una volta sola all'avvio)"""
        out = {}
        if not self.pool: return out
        try:
            for c in self._lista(self.pool.get_components()):
                pk = c.get_pkgname()
                if pk and pk not in out and c.get_kind() == self.AS.ComponentKind.DESKTOP_APP:
                    i = self.icona(c)
                    if i: out[pk] = i
        except Exception as e:
            print("SoStore: icone:", e, file=sys.stderr)
        return out

    def cerca(self, testo, massimo=60):
        if not self.pool or not testo.strip(): return []
        out, visti = [], set()
        for c in self._lista(self.pool.search(testo.strip())):
            try:
                if c.get_kind() != self.AS.ComponentKind.DESKTOP_APP: continue
                pk = c.get_pkgname() or ""
                if not pk or pk in visti: continue
                visti.add(pk)
                desktop = None
                l = c.get_launchable(self.AS.LaunchableKind.DESKTOP_ID)
                if l and l.get_entries(): desktop = l.get_entries()[0]
                icona = self.icona(c) or (desktop or "").replace(".desktop", "")
                out.append({"pacchetto": pk, "nome": c.get_name() or pk, "descrizione": c.get_summary() or "",
                            "lunga": pulisci(c.get_description() or ""),
                            "icona": icona, "desktop": desktop})
            except Exception:
                continue
            if len(out) >= massimo: break
        return out

    def dettagli(self, pacchetto):
        if not self.pool: return None
        r = self.cerca(pacchetto, 200)
        for x in r:
            if x["pacchetto"] == pacchetto: return x
        return None

class Icone:
    """icone dei programmi non ancora installati: scaricate una volta e tenute in ~/.cache"""
    def __init__(self):
        self.rete = QNetworkAccessManager(); self.attese = {}

    def metti(self, etichetta, sorgente, lato):
        if not (isinstance(sorgente, str) and sorgente.startswith("https://")):
            etichetta.setPixmap(icona_da_nome(sorgente).pixmap(QSize(lato, lato))); return
        nome = re.sub(r"[^A-Za-z0-9._-]", "_", sorgente.split("://", 1)[1])[-120:]
        f = os.path.join(CACHE_ICONE, nome)
        if os.path.exists(f):
            etichetta.setPixmap(QIcon(f).pixmap(QSize(lato, lato))); return
        etichetta.setPixmap(QIcon.fromTheme("application-x-executable").pixmap(QSize(lato, lato)))
        self.attese.setdefault(sorgente, []).append((etichetta, lato))
        if len(self.attese[sorgente]) > 1: return
        r = self.rete.get(QNetworkRequest(QUrl(sorgente)))
        def arrivata():
            dati = bytes(r.readAll()); r.deleteLater()
            if r.error() != r.NetworkError.NoError: print("SoStore: icona non scaricata:", r.attribute(QNetworkRequest.Attribute.HttpStatusCodeAttribute), r.errorString()[-120:], file=sys.stderr)
            if dati[:8] == b"\x89PNG\r\n\x1a\n":
                try:
                    os.makedirs(CACHE_ICONE, exist_ok=True); open(f, "wb").write(dati)
                except OSError: pass
            for et, l in self.attese.pop(sorgente, []):
                try:
                    if os.path.exists(f): et.setPixmap(QIcon(f).pixmap(QSize(l, l)))
                except RuntimeError: pass   # scheda gia' chiusa
        r.finished.connect(arrivata)

# ---------------------------------------------------------------- interfaccia
class Scheda(QFrame):
    def __init__(self, app, finestra):
        super().__init__(); self.app = app; self.f = finestra
        self.setObjectName("scheda"); self.setCursor(Qt.CursorShape.PointingHandCursor); self.setMinimumHeight(92); self.setSizePolicy(QSizePolicy.Policy.Preferred, QSizePolicy.Policy.Maximum)
        h = QHBoxLayout(self); h.setContentsMargins(14, 12, 14, 12); h.setSpacing(12)
        i = QLabel(); i.setFixedSize(52, 52); finestra.icone.metti(i, app.get("icona"), 52); h.addWidget(i)
        v = QVBoxLayout(); v.setSpacing(2)
        n = QLabel(app["nome"]); n.setObjectName("nomeapp"); n.setWordWrap(True); v.addWidget(n)
        d = QLabel(app.get("descrizione", "")); d.setObjectName("descr"); d.setWordWrap(True); v.addWidget(d); v.addStretch()
        for x in (n, d): x.setMinimumWidth(10)
        self.setMinimumWidth(10)
        h.addLayout(v, 1)
        self.b = QPushButton(); self.b.setObjectName("azione"); self.b.setFixedWidth(84); h.addWidget(self.b, 0, Qt.AlignmentFlag.AlignVCenter)
        self.b.clicked.connect(self.premi); self.aggiorna()

    def aggiorna(self):
        if self.f.in_corso.get(self.app["pacchetto"]):
            self.b.setText("…"); self.b.setEnabled(False); self.b.setObjectName("azione")
        elif self.f.e_installato(self.app):
            self.b.setText("Apri"); self.b.setEnabled(True); self.b.setObjectName("secondario")
        else:
            self.b.setText("Installa"); self.b.setEnabled(True); self.b.setObjectName("azione")
        self.b.style().unpolish(self.b); self.b.style().polish(self.b)

    def premi(self):
        if self.f.e_installato(self.app): self.f.apri(self.app)
        else: self.f.installa(self.app)

    def mousePressEvent(self, e):
        if e.button() == Qt.MouseButton.LeftButton: self.f.mostra_dettaglio(self.app)

class SoStore(QWidget):
    def __init__(self):
        super().__init__()
        self.setObjectName("finestra"); self.setWindowTitle("SoStore"); self.setWindowIcon(QIcon.fromTheme("sofios-store", QIcon(LOGO)))
        self.setStyleSheet(STILE); self.resize(1040, 700)
        self.catalogo = carica_catalogo(); self.fonte = Catalogo(); self.in_corso = {}; self.schede = []; self.icone = Icone()
        self.android = AND.CatalogoAndroid(); self.android_installate = set(); self.pagina = "vetrina"
        icone = self.fonte.icone_per_pacchetto()
        for a in self.catalogo.get("vetrina", []):
            if a["pacchetto"] in icone and QIcon.fromTheme(a.get("icona", "")).isNull(): a["icona"] = icone[a["pacchetto"]]
        h = QHBoxLayout(self); h.setContentsMargins(0, 0, 0, 0); h.setSpacing(0)
        # lato
        lato = QWidget(); lato.setObjectName("lato"); lato.setFixedWidth(220)
        lv = QVBoxLayout(lato); lv.setContentsMargins(14, 18, 14, 14); lv.setSpacing(6)
        m = QHBoxLayout(); lg = QLabel(); lg.setPixmap(QIcon.fromTheme("sofios-store", QIcon(LOGO)).pixmap(QSize(34, 34))); m.addWidget(lg)
        t = QLabel("SoStore"); t.setObjectName("marchio"); m.addWidget(t); m.addStretch(); lv.addLayout(m); lv.addSpacing(12)
        self.voci = {}
        for chiave, testo in (("vetrina", "In evidenza"), ("android", "App Android"), ("installati", "Installati")):
            b = QPushButton(testo); b.setObjectName("voce"); b.setCheckable(True); b.clicked.connect(lambda _, k=chiave: self.vai(k))
            self.voci[chiave] = b; lv.addWidget(b)
        lv.addStretch(); lv.addWidget(bottone_informazioni(self, "SoStore", "Il negozio dei programmi di SofiOS."))
        h.addWidget(lato)
        # contenuto
        dx = QWidget(); dv = QVBoxLayout(dx); dv.setContentsMargins(24, 18, 24, 12); dv.setSpacing(10)
        self.cerca = QLineEdit(); self.cerca.setPlaceholderText("Cerca un programma…"); self.cerca.setClearButtonEnabled(True)
        self.cerca.returnPressed.connect(self.esegui_ricerca); dv.addWidget(self.cerca)
        self.pagine = QStackedWidget(); dv.addWidget(self.pagine, 1)
        self.stato = QLabel(""); self.stato.setObjectName("descr"); dv.addWidget(self.stato)
        h.addWidget(dx, 1)
        self.p_lista = self._area(); self.pagine.addWidget(self.p_lista[0])
        self.p_dett = QWidget(); self.pagine.addWidget(self.p_dett)
        self.vai("vetrina")
        if self.fonte.numero() < 100 and not os.environ.get("SOFIOS_FOTO"):
            QTimer.singleShot(500, self.aggiorna_catalogo_programmi)

    def aggiorna_catalogo_programmi(self):
        """primo avvio senza catalogo: lo scarica (serve Internet, non serve la password)"""
        self.stato.setText("Preparo il catalogo dei programmi…")
        p = QProcess(self)
        def fine(*_):
            self.fonte = Catalogo(); icone = self.fonte.icone_per_pacchetto()
            for a in self.catalogo.get("vetrina", []):
                if a["pacchetto"] in icone and QIcon.fromTheme(a.get("icona", "")).isNull(): a["icona"] = icone[a["pacchetto"]]
            self.stato.setText("" if self.fonte.numero() >= 100 else "Catalogo non disponibile: controlla la connessione a Internet.")
            if self.pagina in ("vetrina", "installati"): self.vai(self.pagina)
        p.finished.connect(fine); p.errorOccurred.connect(lambda _: fine())
        p.start("pkcon", ["refresh", "-p"])

    def _area(self):
        s = QScrollArea(); s.setWidgetResizable(True); s.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        w = QWidget(); w.setObjectName("contenitore"); s.setWidget(w); s.viewport().setObjectName("vista")
        v = QVBoxLayout(w); v.setContentsMargins(0, 0, 8, 0); v.setSpacing(8)
        return s, v

    def _svuota(self, v):
        while v.count():
            it = v.takeAt(0); w = it.widget()
            if w: w.deleteLater()
            elif it.layout():
                self._svuota(it.layout())
        self.schede = []

    def _griglia(self, v, apps):
        g = QGridLayout(); g.setSpacing(10)
        for n, a in enumerate(apps):
            s = Scheda(a, self); self.schede.append(s); g.addWidget(s, n // 2, n % 2)
        g.setColumnStretch(0, 1); g.setColumnStretch(1, 1)
        v.addLayout(g)

    def vai(self, chiave):
        self.pagina = chiave
        self.cerca.blockSignals(True); self.cerca.clear(); self.cerca.blockSignals(False)
        self.cerca.setPlaceholderText("Cerca un'app Android…" if chiave == "android" else "Cerca un programma…")
        for k, b in self.voci.items(): b.setChecked(k == chiave)
        self.pagine.setCurrentIndex(0); v = self.p_lista[1]; self._svuota(v)
        apps = self.catalogo.get("vetrina", [])
        if chiave == "android":
            self.pagina_android(v); return
        if chiave == "vetrina":
            t = QLabel("In evidenza"); t.setObjectName("titolo"); v.addWidget(t)
            cat = []
            for a in apps:
                if a.get("categoria") not in cat: cat.append(a.get("categoria"))
            for c in cat:
                s = QLabel(c); s.setObjectName("sezione"); v.addWidget(s)
                self._griglia(v, [a for a in apps if a.get("categoria") == c])
        else:
            t = QLabel("Installati"); t.setObjectName("titolo"); v.addWidget(t)
            ins = [a for a in apps if installato(a["pacchetto"])]
            visti = {a["pacchetto"] for a in ins}
            ins += [a for p, a in sorted(leggi_miei().items(), key=lambda x: (x[1].get("nome") or "").lower()) if p not in visti and installato(p)]
            if ins: self._griglia(v, ins)
            else:
                e = QLabel("Non hai ancora installato programmi da SoStore."); e.setObjectName("vuoto"); v.addWidget(e)
        v.addStretch()

    def esegui_ricerca(self):
        q = self.cerca.text().strip()
        if self.pagina == "android":
            v = self.p_lista[1]; self._svuota(v); self.pagina_android(v, q); return
        if not q: self.vai("vetrina"); return
        for b in self.voci.values(): b.setChecked(False)
        self.pagine.setCurrentIndex(0); v = self.p_lista[1]; self._svuota(v)
        t = QLabel("Risultati per «%s»" % q); t.setObjectName("titolo"); v.addWidget(t)
        ql = q.lower()
        nostri = [a for a in self.catalogo.get("vetrina", []) if ql in a["nome"].lower() or ql in a.get("descrizione", "").lower() or ql in a["pacchetto"]]
        altri = [r for r in self.fonte.cerca(q) if r["pacchetto"] not in {a["pacchetto"] for a in nostri}]
        if not nostri and not altri:
            e = QLabel("Nessun programma trovato. Prova con un'altra parola."); e.setObjectName("vuoto"); v.addWidget(e)
        if nostri:
            s = QLabel("In evidenza"); s.setObjectName("sezione"); v.addWidget(s); self._griglia(v, nostri)
        if altri:
            s = QLabel("Tutto il catalogo"); s.setObjectName("sezione"); v.addWidget(s); self._griglia(v, altri)
        v.addStretch()

    def mostra_dettaglio(self, app):
        vecchio = self.p_dett; self.p_dett = QWidget(); self.pagine.insertWidget(1, self.p_dett); self.pagine.removeWidget(vecchio); vecchio.deleteLater()
        v = QVBoxLayout(self.p_dett); v.setContentsMargins(0, 0, 0, 0); v.setSpacing(12)
        ind = QPushButton("‹  Indietro"); ind.setObjectName("indietro"); ind.clicked.connect(lambda: self.pagine.setCurrentIndex(0)); v.addWidget(ind, 0, Qt.AlignmentFlag.AlignLeft)
        r = QHBoxLayout(); r.setSpacing(18)
        i = QLabel(); i.setFixedSize(96, 96); self.icone.metti(i, app.get("icona"), 96); r.addWidget(i, 0, Qt.AlignmentFlag.AlignTop)
        c = QVBoxLayout(); n = QLabel(app["nome"]); n.setObjectName("grande"); c.addWidget(n)
        d = QLabel(app.get("descrizione", "")); d.setObjectName("testo"); d.setWordWrap(True); c.addWidget(d)
        bb = QHBoxLayout(); self.d_azione = QPushButton(); self.d_azione.setObjectName("azione"); self.d_azione.setFixedWidth(120); bb.addWidget(self.d_azione)
        self.d_rimuovi = QPushButton("Rimuovi"); self.d_rimuovi.setObjectName("secondario"); self.d_rimuovi.setFixedWidth(120); bb.addWidget(self.d_rimuovi); bb.addStretch()
        c.addLayout(bb); self.d_barra = QProgressBar(); self.d_barra.setRange(0, 100); self.d_barra.setFixedWidth(300); self.d_barra.hide(); c.addWidget(self.d_barra)
        r.addLayout(c, 1); v.addLayout(r)
        lunga = app.get("lunga") or ("" if app.get("tipo") == "android" else (self.fonte.dettagli(app["pacchetto"]) or {}).get("lunga", ""))
        if lunga:
            sa = QScrollArea(); sa.setWidgetResizable(True); sa.setHorizontalScrollBarPolicy(Qt.ScrollBarPolicy.ScrollBarAlwaysOff); sa.viewport().setObjectName("vista")
            l = QLabel(lunga); l.setObjectName("testo"); l.setWordWrap(True); l.setAlignment(Qt.AlignmentFlag.AlignTop)
            l.setContentsMargins(4, 4, 12, 4); sa.setWidget(l); v.addWidget(sa, 1)
        else:
            v.addStretch()
        self.d_app = app
        self.d_azione.clicked.connect(lambda: self.apri(app) if self.e_installato(app) else self.installa(app))
        self.d_rimuovi.clicked.connect(lambda: self.rimuovi(app))
        self.aggiorna_dettaglio(); self.pagine.setCurrentIndex(1)

    def aggiorna_dettaglio(self):
        if not hasattr(self, "d_app"): return
        a = self.d_app; occ = self.in_corso.get(a["pacchetto"]); ins = self.e_installato(a)
        try:
            self.d_azione.setText("…" if occ else ("Apri" if ins else "Installa")); self.d_azione.setEnabled(not occ)
            self.d_rimuovi.setVisible(ins and not occ); self.d_barra.setVisible(bool(occ))
        except RuntimeError: pass

    def aggiorna_tutto(self):
        for s in list(self.schede):
            try: s.aggiorna()
            except RuntimeError: pass
        self.aggiorna_dettaglio()

    # --- azioni
    def e_installato(self, app):
        if app.get("tipo") == "android": return app["pacchetto"] in self.android_installate
        return installato(app["pacchetto"])

    def apri(self, app):
        if app.get("tipo") == "android":
            QProcess.startDetached("waydroid", ["app", "launch", app["pacchetto"]]); return
        d = file_desktop(app["pacchetto"], app.get("desktop"))
        if not d or not apri_programma(d):
            QMessageBox.information(self, "SoStore", "«%s» è installato: lo trovi nel menu dei programmi." % app["nome"])

    def _esegui(self, app, argomenti, verbo, fatto):
        if self.in_corso:
            QMessageBox.information(self, "SoStore", "Aspetta che finisca l'operazione in corso."); return
        p = QProcess(self); p.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.in_corso[app["pacchetto"]] = p; self.uscita = ""
        self.stato.setText("%s «%s»…" % (verbo, app["nome"])); self.aggiorna_tutto()
        def leggi():
            self.uscita += bytes(p.readAllStandardOutput()).decode("utf-8", "replace")
            m = re.findall(r"Percentage:\s*(\d+)", self.uscita)
            if m:
                try: self.d_barra.setValue(int(m[-1]))
                except RuntimeError: pass
                self.stato.setText("%s «%s»… %s%%" % (verbo, app["nome"], m[-1]))
        def fine(codice, _):
            self.in_corso.pop(app["pacchetto"], None)
            if codice == 0 and fatto(): self.stato.setText("Fatto: «%s»." % app["nome"])
            elif "Not authorized" in self.uscita or "authoriz" in self.uscita.lower() or codice in (126, 127):
                self.stato.setText("Operazione annullata.")
            else:
                self.stato.setText("Non è riuscito. Controlla la connessione a Internet e riprova.")
                print(self.uscita[-2000:], file=sys.stderr)
            self.aggiorna_tutto()
        p.readyReadStandardOutput.connect(leggi); p.finished.connect(fine)
        p.errorOccurred.connect(lambda _: fine(1, None))
        p.start("pkcon", argomenti)

    def installa(self, app):
        if app.get("tipo") == "android": self.installa_android(app); return
        def ok():
            if installato(app["pacchetto"]): segna_mio(app, True); return True
            return False
        self._esegui(app, ["install", "-y", "-p", app["pacchetto"]], "Installo", ok)

    def rimuovi(self, app):
        if QMessageBox.question(self, "SoStore", "Vuoi rimuovere «%s»?" % app["nome"]) != QMessageBox.StandardButton.Yes: return
        if app.get("tipo") == "android":
            p = QProcess(self); p.finished.connect(lambda *_: (self.leggi_android_installate(), self.aggiorna_tutto()))
            p.start("waydroid", ["app", "remove", app["pacchetto"]]); return
        def ok():
            if not installato(app["pacchetto"]): segna_mio(app, False); return True
            return False
        self._esegui(app, ["remove", "-y", "-p", app["pacchetto"]], "Rimuovo", ok)

    # ------------------------------------------------------------ Android
    def stato_android(self):
        finto = os.environ.get("SOFIOS_ANDROID_FINTO")      # solo per le prove (schermate senza Android vero)
        if finto: return tuple(finto.split(":")) if ":" in finto else (finto, "")
        return AND.stato_waydroid()

    def leggi_android_installate(self):
        self.android_installate = set()
        try:
            r = subprocess.run(["waydroid", "app", "list"], capture_output=True, text=True, timeout=20)
            self.android_installate = set(re.findall(r"packageName:\s*(\S+)", r.stdout))
        except Exception: pass

    def _riquadro(self, v, titolo, testo, bottone=None, azione=None, secondario=False):
        f = QFrame(); f.setObjectName("scheda"); f.setCursor(Qt.CursorShape.ArrowCursor)
        h = QVBoxLayout(f); h.setContentsMargins(18, 14, 18, 14); h.setSpacing(6)
        n = QLabel(titolo); n.setObjectName("nomeapp"); h.addWidget(n)
        d = QLabel(testo); d.setObjectName("descr"); d.setWordWrap(True); h.addWidget(d)
        if bottone:
            b = QPushButton(bottone); b.setObjectName("secondario" if secondario else "azione"); b.clicked.connect(azione)
            h.addWidget(b, 0, Qt.AlignmentFlag.AlignLeft)
        v.addWidget(f); return f

    def pagina_android(self, v, q=""):
        t = QLabel("App Android"); t.setObjectName("titolo"); v.addWidget(t)
        stato, tipo = self.stato_android()
        if stato == "assente":
            self._riquadro(v, "Android non è ancora su questo computer",
                           "Con Android puoi usare le app del telefono sul computer. Serve circa 1 GB di spazio.",
                           "Installa Android", lambda: self.installa({"pacchetto": "waydroid", "nome": "Android"}))
            v.addStretch(); return
        if stato == "da_attivare":
            i = QLabel("Scegli come vuoi Android. Potrai cambiare idea più avanti."); i.setObjectName("testo"); i.setWordWrap(True); v.addWidget(i)
            self._riquadro(v, "Android senza Google",
                           "App libere e gratuite dal catalogo F-Droid. Niente account Google, più riservatezza. "
                           "Non ci sono WhatsApp, Instagram e le app delle banche.",
                           "Attiva senza Google", lambda: self.attiva_android("VANILLA"))
            self._riquadro(v, "Android con Google Play",
                           "Anche le app del Play Store, come WhatsApp. Serve un account Google e registrare una volta questo computer "
                           "su una pagina di Google (ti guidiamo noi). Le app delle banche e dei pagamenti spesso non funzionano.",
                           "Attiva con Google Play", lambda: self.attiva_android("GAPPS"))
            n = QLabel("L'attivazione scarica Android da Internet (circa 1 GB): può richiedere un po' di tempo."); n.setObjectName("descr"); n.setWordWrap(True); v.addWidget(n)
            v.addStretch(); return
        # pronto
        r = QHBoxLayout()
        b = QPushButton("Apri Android"); b.setObjectName("secondario"); b.clicked.connect(lambda: QProcess.startDetached("waydroid", ["show-full-ui"])); r.addWidget(b)
        if tipo == "GAPPS":
            g = QPushButton("Apri Google Play"); g.setObjectName("azione"); g.clicked.connect(lambda: QProcess.startDetached("waydroid", ["app", "launch", "com.android.vending"])); r.addWidget(g)
            c = QPushButton("Registra il computer su Google"); c.setObjectName("secondario"); c.clicked.connect(self.registra_google); r.addWidget(c)
        altro = "VANILLA" if tipo == "GAPPS" else "GAPPS"
        cb = QPushButton("Passa a Android senza Google" if altro == "VANILLA" else "Passa a Android con Google Play"); cb.setObjectName("indietro")
        cb.clicked.connect(lambda: QMessageBox.question(self, "SoStore", "Android verrà preparato di nuovo: le app Android installate andranno reinstallate. Continuo?")
                           == QMessageBox.StandardButton.Yes and self.attiva_android(altro))
        r.addStretch(); r.addWidget(cb); v.addLayout(r)
        if not self.android.app:
            if self.android.da_aggiornare(ore=24 * 30) or not self.android.carica():
                self.aggiorna_catalogo_android(); e = QLabel("Scarico il catalogo delle app Android…"); e.setObjectName("vuoto"); v.addWidget(e); v.addStretch(); return
        elif self.android.da_aggiornare(ore=24 * 7):   # il catalogo pesa ~70 MB: una volta alla settimana
            self.aggiorna_catalogo_android(silenzioso=True)
        if not hasattr(self, "_letto_android"): self.leggi_android_installate(); self._letto_android = True
        if not q:   # prima le app scelte da noi, con il nome e la descrizione in italiano
            indice = {a["pacchetto"]: a for a in self.android.app}
            scelte = []
            for x in self.catalogo.get("android", []):
                a = indice.get(x["pacchetto"])
                if a: scelte.append(dict(a, nome=x.get("nome", a["nome"]), descrizione=x.get("descrizione", a["descrizione"])))
            if scelte:
                s = QLabel("In evidenza"); s.setObjectName("sezione"); v.addWidget(s); self._griglia(v, scelte)
            s = QLabel("Aggiornate di recente"); s.setObjectName("sezione"); v.addWidget(s)
            apps = [a for a in self.android.cerca("", 40) if a["pacchetto"] not in {x["pacchetto"] for x in scelte}][:20]
        else:
            s = QLabel("Risultati per «%s»" % q); s.setObjectName("sezione"); v.addWidget(s)
            apps = self.android.cerca(q, 40)
        if apps: self._griglia(v, apps)
        else:
            e = QLabel("Nessuna app trovata."); e.setObjectName("vuoto"); v.addWidget(e)
        v.addStretch()

    def attiva_android(self, tipo):
        if self.in_corso: QMessageBox.information(self, "SoStore", "Aspetta che finisca l'operazione in corso."); return
        p = QProcess(self); p.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
        self.in_corso["android"] = p; self.uscita = ""; self.stato.setText("Attivo Android: scarico (circa 1 GB)…")
        def leggi():
            self.uscita += bytes(p.readAllStandardOutput()).decode("utf-8", "replace")
            righe = [x.strip() for x in re.split(r"[\r\n]", self.uscita) if x.strip()]
            m = re.findall(r"(\d+(?:\.\d+)?)\s*/\s*(\d+(?:\.\d+)?)\s*MB", self.uscita)
            if m: self.stato.setText("Attivo Android: scaricati %s di %s MB…" % (int(float(m[-1][0])), int(float(m[-1][1]))))
            elif righe: self.stato.setText("Attivo Android… " + righe[-1][-80:])
        def fine(codice, _):
            self.in_corso.pop("android", None)
            if codice == 0: self.stato.setText("Android è attivo.")
            elif codice in (126, 127): self.stato.setText("Operazione annullata.")
            else:
                self.stato.setText("Android non si è attivato. Controlla la connessione a Internet e riprova."); print(self.uscita[-3000:], file=sys.stderr)
            self.vai("android")
        p.readyReadStandardOutput.connect(leggi); p.finished.connect(fine); p.errorOccurred.connect(lambda _: fine(1, None))
        p.start("pkexec", ["/usr/local/lib/sofios/android-attiva", tipo])

    def aggiorna_catalogo_android(self, silenzioso=False):
        if getattr(self, "_scarico_catalogo", False): return
        self._scarico_catalogo = True
        os.makedirs(AND.CACHE, exist_ok=True)
        tmp = {"json": os.path.join(AND.CACHE, "index-v2.json.nuovo"), "asc": os.path.join(AND.CACHE, "index-v2.json.asc.nuovo")}
        presi = {}
        def finito():
            self._scarico_catalogo = False
            if len(presi) < 2: 
                if not silenzioso: self.stato.setText("Non riesco a scaricare il catalogo Android: controlla la connessione.")
                return
            if not AND.firma_valida(tmp["json"], tmp["asc"]):
                self.stato.setText("Catalogo Android scartato: la firma di F-Droid non è valida."); return
            os.replace(tmp["json"], self.android.file_catalogo()); os.replace(tmp["asc"], self.android.file_catalogo() + ".asc")
            self.android.carica()
            if not silenzioso: self.stato.setText("Catalogo Android aggiornato: %d app." % len(self.android.app))
            if self.pagina == "android": self.vai("android")
        def scarica(chiave, url):
            r = self.icone.rete.get(QNetworkRequest(QUrl(url)))
            def fatto():
                if r.error() == r.NetworkError.NoError:
                    with open(tmp[chiave], "wb") as f: f.write(bytes(r.readAll()))
                    presi[chiave] = True
                r.deleteLater(); attesi.discard(chiave)
                if not attesi: finito()
            r.finished.connect(fatto)
        attesi = {"json", "asc"}
        scarica("json", AND.REPO + "/index-v2.json"); scarica("asc", AND.REPO + "/index-v2.json.asc")

    def installa_android(self, app):
        if self.in_corso: QMessageBox.information(self, "SoStore", "Aspetta che finisca l'operazione in corso."); return
        self.in_corso[app["pacchetto"]] = True; self.stato.setText("Scarico «%s»…" % app["nome"]); self.aggiorna_tutto()
        cartella = os.path.join(AND.CACHE, "apk"); os.makedirs(cartella, exist_ok=True)
        f = os.path.join(cartella, app["pacchetto"] + ".apk")
        r = self.icone.rete.get(QNetworkRequest(QUrl(app["apk"])))
        def errore(msg):
            self.in_corso.pop(app["pacchetto"], None); self.stato.setText(msg); self.aggiorna_tutto()
        def scaricata():
            ok = r.error() == r.NetworkError.NoError
            if ok:
                with open(f, "wb") as h: h.write(bytes(r.readAll()))
            r.deleteLater()
            if not ok: errore("Non riesco a scaricare «%s»." % app["nome"]); return
            if AND.sha256_file(f) != app["sha256"]:
                os.remove(f); errore("«%s» scartata: il file non corrisponde al catalogo." % app["nome"]); return
            self.stato.setText("Installo «%s» in Android…" % app["nome"])
            if not AND.sessione_attiva():
                QProcess.startDetached("waydroid", ["session", "start"])
            self._attesa = 0
            def prova():
                if not AND.sessione_attiva() and self._attesa < 60:
                    self._attesa += 1; QTimer.singleShot(1000, prova); return
                p = QProcess(self); p.setProcessChannelMode(QProcess.ProcessChannelMode.MergedChannels)
                def fine(codice, _):
                    self.in_corso.pop(app["pacchetto"], None); self.leggi_android_installate()
                    self.stato.setText(("Fatto: «%s»." if app["pacchetto"] in self.android_installate else "«%s» non si è installata.") % app["nome"])
                    self.aggiorna_tutto()
                p.finished.connect(fine); p.start("waydroid", ["app", "install", f])
            prova()
        r.downloadProgress.connect(lambda a, b: self.stato.setText("Scarico «%s»… %d%%" % (app["nome"], a * 100 // b)) if b > 0 else None)
        r.finished.connect(scaricata)

    def registra_google(self):
        try:
            r = subprocess.run(["pkexec", "/usr/local/lib/sofios/android-attiva", "id-google"], capture_output=True, text=True, timeout=120)
            codice = (re.findall(r"\b\d{10,}\b", r.stdout) or [""])[-1]
        except Exception:
            codice = ""
        if not codice:
            QMessageBox.information(self, "SoStore", "Apri prima Google Play una volta e accedi con il tuo account, poi riprova."); return
        QApplication.clipboard().setText(codice)
        QMessageBox.information(self, "Registra il computer su Google",
            "Il codice di questo computer è:\n\n%s\n\nL'ho già copiato. Ora si apre la pagina di Google: accedi, incolla il codice e premi «Registra». "
            "Dopo qualche minuto riavvia Android e Google Play funzionerà." % codice)
        QProcess.startDetached("xdg-open", ["https://www.google.com/android/uncertified"])


def main():
    app = QApplication(sys.argv); app.setApplicationName("SoStore"); app.setDesktopFileName("sofios-store")
    if os.environ.get("SOFIOS_TEMA_ICONE"): QIcon.setThemeName(os.environ["SOFIOS_TEMA_ICONE"])   # solo per le prove
    w = SoStore(); w.show()
    foto = os.environ.get("SOFIOS_FOTO")   # per le prove: schermate vere
    if foto:
        passi = [("vetrina", lambda: w.vai("vetrina"))]
        q = os.environ.get("SOFIOS_CERCA")
        if q: passi.append(("cerca", lambda: (w.cerca.setText(q), w.esegui_ricerca())))
        d = os.environ.get("SOFIOS_DETTAGLIO")
        if d:
            def dett():
                a = next((x for x in w.catalogo["vetrina"] if x["pacchetto"] == d), None) or w.fonte.dettagli(d) or {"pacchetto": d, "nome": d}
                w.mostra_dettaglio(a)
            passi.append(("dettaglio", dett))
        if os.environ.get("SOFIOS_ANDROID_FOTO"):
            passi.append(("android", lambda: w.vai("android")))
            passi.append(("android-catalogo", lambda: None))
            qa = os.environ.get("SOFIOS_CERCA_ANDROID")
            if qa: passi.append(("android-cerca", lambda: (w.cerca.setText(qa), w.esegui_ricerca())))
        ins = os.environ.get("SOFIOS_INSTALLA")
        if ins:
            def installa_e_aspetta():
                a = next((x for x in w.catalogo["vetrina"] if x["pacchetto"] == ins), {"pacchetto": ins, "nome": ins})
                w.mostra_dettaglio(a); w.installa(a)
            passi.append(("installazione", installa_e_aspetta))
            passi.append(("installato", lambda: None))
            passi.append(("installati", lambda: w.vai("installati")))
        def scatta(i=0):
            if i >= len(passi): app.quit(); return
            passi[i][1]()
            def salva():
                if passi[i][0] == "android-catalogo" and getattr(w, "_scarico_catalogo", False):
                    scatta.attese = getattr(scatta, "attese", 0) + 1
                    if scatta.attese < 200: QTimer.singleShot(1500, salva); return
                if passi[i][0] == "android-catalogo" and not getattr(scatta, "ridisegnato", False):
                    scatta.ridisegnato = True; w.vai("android"); QTimer.singleShot(6000, salva); return
                if passi[i][0] == "installato" and w.in_corso:   # aspetta la fine dell'installazione (max 10 minuti)
                    scatta.attese = getattr(scatta, "attese", 0) + 1
                    if scatta.attese < 400: QTimer.singleShot(1500, salva); return
                w.grab().save(foto.replace(".png", "-%s.png" % passi[i][0])); scatta(i + 1)
            QTimer.singleShot(4000 if passi[i][0] == "installazione" else 5000, salva)
        QTimer.singleShot(1500, scatta)
    return app.exec()

if __name__ == "__main__": sys.exit(main())
