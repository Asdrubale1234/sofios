#!/usr/bin/python3
# Cassaforte Password (SofiOS): cassaforte nel formato KeePass (.kdbx). La cifratura la fa la libreria pykeepass, non codice nostro.
import os, sys, shutil, secrets, string
sys.path.insert(0, "/usr/local/lib/sofios")
from sofios_info import bottone_informazioni
from PyQt6.QtCore import Qt, QTimer, QEvent, QMimeData
from PyQt6.QtGui import QIcon, QGuiApplication
from PyQt6.QtWidgets import (QApplication, QWidget, QListWidget, QListWidgetItem, QPushButton, QHBoxLayout,
                             QVBoxLayout, QLabel, QLineEdit, QStackedWidget, QDialog, QPlainTextEdit,
                             QMessageBox, QFormLayout)
from pykeepass import PyKeePass, create_database

FILE = os.environ.get("SOFIOS_PASSWORD_FILE", os.path.expanduser("~/Password/cassaforte.kdbx"))
LOGO = os.environ.get("SOFIOS_LOGO", "/usr/share/sofios/logo.png")
BLOCCO_MS = 5 * 60 * 1000      # si blocca da sola dopo 5 minuti senza uso
CANCELLA_MS = 20 * 1000        # la password copiata sparisce dagli appunti dopo 20 secondi
STILE = """
QWidget#finestra, QDialog { background: #0b2740; }
QLabel { color: #e6f1ff; font-size: 13px; }
QLabel#titolo { color: #ffffff; font-size: 18px; font-weight: 700; }
QLabel#grande { color: #ffffff; font-size: 24px; font-weight: 700; }
QLabel#piccolo { color: #8fb3d4; font-size: 12px; }
QLabel#avviso { color: #ffd479; font-size: 12px; }
QLineEdit, QPlainTextEdit { background: #12365a; border: 1px solid #1e4f7c; border-radius: 10px; color: #e6f1ff; font-size: 14px; padding: 9px 11px; selection-background-color: #1e6fa8; }
QLineEdit:focus, QPlainTextEdit:focus { border: 1px solid #ffd479; }
QListWidget { background: #12365a; border: none; border-radius: 12px; color: #e6f1ff; font-size: 13px; padding: 6px; outline: 0; }
QListWidget::item { padding: 9px 10px; border-radius: 8px; }
QListWidget::item:selected { background: #1e6fa8; color: #ffffff; }
QPushButton { background: #ffd479; color: #0b2740; border: none; border-radius: 10px; padding: 9px 16px; font-size: 13px; font-weight: 700; }
QPushButton:hover { background: #ffe19e; }
QPushButton#secondario { background: #1e6fa8; color: #ffffff; font-weight: 600; }
QPushButton#secondario:hover { background: #2a82c2; }
QPushButton#piccolo { background: #1e4f7c; color: #e6f1ff; font-weight: 600; padding: 7px 12px; }
QWidget#scheda { background: #12365a; border-radius: 14px; }
"""

def genera(n=20):
    alfabeto = string.ascii_letters + string.digits + "-_.!?#"
    while True:
        p = "".join(secrets.choice(alfabeto) for _ in range(n))
        if any(c.islower() for c in p) and any(c.isupper() for c in p) and any(c.isdigit() for c in p):
            return p

class Modifica(QDialog):
    def __init__(self, parent, voce=None):
        super().__init__(parent)
        self.setWindowTitle("Nuova password" if voce is None else "Modifica"); self.setStyleSheet(STILE); self.setMinimumWidth(460)
        f = QFormLayout(); f.setSpacing(10)
        self.titolo = QLineEdit(voce.title if voce else ""); self.titolo.setPlaceholderText("Per esempio: Posta, Banca…")
        self.utente = QLineEdit(voce.username or "" if voce else "")
        self.pw = QLineEdit(voce.password or "" if voce else genera()); self.pw.setEchoMode(QLineEdit.EchoMode.Password)
        self.sito = QLineEdit(voce.url or "" if voce else "")
        self.note = QPlainTextEdit(voce.notes or "" if voce else ""); self.note.setFixedHeight(70)
        riga = QHBoxLayout(); riga.addWidget(self.pw, 1)
        mostra = QPushButton("Mostra"); mostra.setObjectName("piccolo"); mostra.setCheckable(True)
        mostra.toggled.connect(lambda s: self.pw.setEchoMode(QLineEdit.EchoMode.Normal if s else QLineEdit.EchoMode.Password))
        gen = QPushButton("Genera"); gen.setObjectName("piccolo"); gen.clicked.connect(lambda: (self.pw.setText(genera()), mostra.setChecked(True)))
        riga.addWidget(mostra); riga.addWidget(gen)
        f.addRow("Nome", self.titolo); f.addRow("Utente", self.utente); f.addRow("Password", riga)
        f.addRow("Sito", self.sito); f.addRow("Note", self.note)
        b = QHBoxLayout(); b.addStretch(1)
        ann = QPushButton("Annulla"); ann.setObjectName("secondario"); ann.clicked.connect(self.reject)
        ok = QPushButton("Salva"); ok.clicked.connect(self.accept)
        b.addWidget(ann); b.addWidget(ok)
        v = QVBoxLayout(self); v.setContentsMargins(22, 20, 22, 18); v.setSpacing(14); v.addLayout(f); v.addLayout(b)

class Password(QWidget):
    def __init__(self):
        super().__init__()
        self.setObjectName("finestra"); self.setWindowTitle("Cassaforte Password"); self.setWindowIcon(QIcon(LOGO))
        self.setStyleSheet(STILE); self.resize(880, 580)
        self.kp = None; self.voce = None; self.mostra_pw = False
        self.pagine = QStackedWidget(); v = QVBoxLayout(self); v.setContentsMargins(0, 0, 0, 0); v.addWidget(self.pagine)
        self.pagine.addWidget(self.crea_sblocco()); self.pagine.addWidget(self.crea_principale())
        self.t_blocco = QTimer(self); self.t_blocco.setSingleShot(True); self.t_blocco.setInterval(BLOCCO_MS); self.t_blocco.timeout.connect(self.blocca)
        self.t_appunti = QTimer(self); self.t_appunti.setSingleShot(True); self.t_appunti.setInterval(CANCELLA_MS); self.t_appunti.timeout.connect(self.pulisci_appunti)
        self.copiato = None
        QApplication.instance().installEventFilter(self)
        self.mostra_sblocco()

    def eventFilter(self, o, e):
        if self.kp and e.type() in (QEvent.Type.KeyPress, QEvent.Type.MouseButtonPress, QEvent.Type.MouseMove):
            self.t_blocco.start()
        return False

    # ---------- sblocco ----------
    def crea_sblocco(self):
        w = QWidget(); l = QVBoxLayout(w); l.setAlignment(Qt.AlignmentFlag.AlignCenter); l.setSpacing(12)
        self.s_titolo = QLabel(); self.s_titolo.setObjectName("grande"); self.s_titolo.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.s_testo = QLabel(); self.s_testo.setObjectName("piccolo"); self.s_testo.setAlignment(Qt.AlignmentFlag.AlignCenter); self.s_testo.setWordWrap(True); self.s_testo.setFixedWidth(340)
        self.s_pw = QLineEdit(); self.s_pw.setEchoMode(QLineEdit.EchoMode.Password); self.s_pw.setPlaceholderText("Password principale"); self.s_pw.setFixedWidth(340)
        self.s_pw2 = QLineEdit(); self.s_pw2.setEchoMode(QLineEdit.EchoMode.Password); self.s_pw2.setPlaceholderText("Ripeti la password principale"); self.s_pw2.setFixedWidth(340)
        self.s_avviso = QLabel("Se la dimentichi, nessuno può recuperare le tue password: nemmeno noi."); self.s_avviso.setObjectName("avviso"); self.s_avviso.setWordWrap(True); self.s_avviso.setFixedWidth(340)
        self.s_errore = QLabel(""); self.s_errore.setObjectName("avviso"); self.s_errore.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.s_bott = QPushButton(); self.s_bott.setFixedWidth(340); self.s_bott.clicked.connect(self.sblocca)
        self.s_pw.returnPressed.connect(self.sblocca); self.s_pw2.returnPressed.connect(self.sblocca)
        for x in (self.s_titolo, self.s_testo, self.s_pw, self.s_pw2, self.s_avviso, self.s_errore, self.s_bott):
            l.addWidget(x, 0, Qt.AlignmentFlag.AlignCenter)
        return w

    def mostra_sblocco(self):
        nuovo = not os.path.exists(FILE)
        self.s_titolo.setText("Crea la tua cassaforte" if nuovo else "Cassaforte Password")
        self.s_testo.setText("Scegli una password principale: sarà l'unica da ricordare." if nuovo else "Inserisci la password principale per aprire la cassaforte.")
        self.s_pw2.setVisible(nuovo); self.s_avviso.setVisible(nuovo)
        self.s_bott.setText("Crea cassaforte" if nuovo else "Sblocca"); self.s_pw.clear(); self.s_pw2.clear(); self.s_errore.setText("")
        self.pagine.setCurrentIndex(0); self.s_pw.setFocus()

    def sblocca(self):
        pw = self.s_pw.text()
        if not os.path.exists(FILE):
            if len(pw) < 8: self.s_errore.setText("Almeno 8 caratteri."); return
            if pw != self.s_pw2.text(): self.s_errore.setText("Le due password non coincidono."); return
            try:
                os.makedirs(os.path.dirname(FILE), mode=0o700, exist_ok=True)
                self.kp = create_database(FILE, password=pw); os.chmod(FILE, 0o600)
            except Exception:
                self.kp = None; self.s_errore.setText("Non riesco a creare la cassaforte. Controlla lo spazio sul disco."); return
        else:
            try:
                self.kp = PyKeePass(FILE, password=pw)
            except Exception as e:
                self.kp = None
                sbagliata = type(e).__name__ == "CredentialsError"
                self.s_errore.setText("Password sbagliata." if sbagliata else "Non riesco ad aprire la cassaforte: il file potrebbe essere danneggiato.")
                self.s_pw.selectAll(); return
        self.s_pw.clear(); self.s_pw2.clear(); self.carica(); self.pagine.setCurrentIndex(1); self.t_blocco.start()

    def blocca(self):
        for d in self.findChildren(QDialog): d.reject()
        self.kp = None; self.voce = None; self.pulisci_appunti(); self.elenco.clear(); self.mostra_sblocco()

    # ---------- principale ----------
    def crea_principale(self):
        w = QWidget(); r = QHBoxLayout(w); r.setContentsMargins(20, 18, 20, 18); r.setSpacing(16)
        sx = QVBoxLayout(); sx.setSpacing(10)
        t = QLabel("Cassaforte Password"); t.setObjectName("titolo"); sx.addWidget(t)
        self.cerca = QLineEdit(); self.cerca.setPlaceholderText("Cerca…"); self.cerca.textChanged.connect(self.carica); sx.addWidget(self.cerca)
        self.elenco = QListWidget(); self.elenco.setFixedWidth(270); self.elenco.currentItemChanged.connect(self.scegli); sx.addWidget(self.elenco, 1)
        nuova = QPushButton("Nuova password"); nuova.clicked.connect(self.nuova); sx.addWidget(nuova)
        bl = QPushButton("Blocca"); bl.setObjectName("secondario"); bl.clicked.connect(self.blocca); sx.addWidget(bl)
        sx.addWidget(bottone_informazioni(self, "Cassaforte Password", "Le tue password al sicuro, in un file protetto da una password principale."))
        r.addLayout(sx)
        self.scheda = QWidget(); self.scheda.setObjectName("scheda"); d = QVBoxLayout(self.scheda); d.setContentsMargins(26, 24, 26, 22); d.setSpacing(6)
        self.d_titolo = QLabel(); self.d_titolo.setObjectName("grande"); d.addWidget(self.d_titolo); d.addSpacing(10)
        self.campi = {}
        for chiave, nome in (("utente", "Utente"), ("pw", "Password"), ("sito", "Sito"), ("note", "Note")):
            e = QLabel(nome); e.setObjectName("piccolo"); d.addWidget(e)
            riga = QHBoxLayout(); val = QLabel(); val.setWordWrap(True); val.setTextInteractionFlags(Qt.TextInteractionFlag.TextSelectableByMouse)
            val.setStyleSheet("font-size:15px; color:#ffffff;"); riga.addWidget(val, 1)
            if chiave in ("utente", "pw"):
                if chiave == "pw":
                    m = QPushButton("Mostra"); m.setObjectName("piccolo"); m.clicked.connect(self.alterna_pw); riga.addWidget(m); self.b_mostra = m
                c = QPushButton("Copia"); c.setObjectName("piccolo"); c.clicked.connect(lambda _, k=chiave: self.copia(k)); riga.addWidget(c)
            d.addLayout(riga); d.addSpacing(8); self.campi[chiave] = val
        self.avviso_copia = QLabel(""); self.avviso_copia.setObjectName("avviso"); d.addWidget(self.avviso_copia)
        d.addStretch(1)
        b = QHBoxLayout(); mod = QPushButton("Modifica"); mod.clicked.connect(self.modifica)
        el = QPushButton("Elimina"); el.setObjectName("secondario"); el.clicked.connect(self.elimina)
        b.addWidget(mod); b.addWidget(el); b.addStretch(1); d.addLayout(b)
        self.vuota = QLabel("Scegli una password dall'elenco\noppure creane una nuova."); self.vuota.setObjectName("piccolo"); self.vuota.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.pila = QStackedWidget(); self.pila.addWidget(self.vuota); self.pila.addWidget(self.scheda); r.addWidget(self.pila, 1)
        return w

    def carica(self, *_, scegli=None):
        if not self.kp: return
        q = self.cerca.text().strip().lower()
        cestino = getattr(self.kp, "recyclebin_group", None)
        voci = [e for e in self.kp.entries if (cestino is None or e.group != cestino) and (not q or q in (e.title or "").lower() or q in (e.username or "").lower() or q in (e.url or "").lower())]
        voci.sort(key=lambda e: (e.title or "").lower())
        self.elenco.blockSignals(True); self.elenco.clear(); riga = -1
        for i, e in enumerate(voci):
            it = QListWidgetItem((e.title or "(senza nome)") + (("\n" + e.username) if e.username else "")); it.setData(Qt.ItemDataRole.UserRole, e.uuid); self.elenco.addItem(it)
            if scegli is not None and e.uuid == scegli: riga = i
        self.elenco.blockSignals(False)
        if self.elenco.count():
            self.elenco.setCurrentRow(max(riga, 0)); self.scegli(self.elenco.currentItem(), None)
        else:
            self.voce = None; self.pila.setCurrentIndex(0)

    def scegli(self, it, _):
        if it is None or not self.kp: return
        self.voce = self.kp.find_entries(uuid=it.data(Qt.ItemDataRole.UserRole), first=True)
        if not self.voce: return
        self.mostra_pw = False; self.b_mostra.setText("Mostra"); self.avviso_copia.setText("")
        self.d_titolo.setText(self.voce.title or "(senza nome)")
        self.campi["utente"].setText(self.voce.username or "—"); self.campi["sito"].setText(self.voce.url or "—"); self.campi["note"].setText(self.voce.notes or "—")
        self.campi["pw"].setText("••••••••••••")
        self.pila.setCurrentIndex(1)

    def alterna_pw(self):
        if not self.voce: return
        self.mostra_pw = not self.mostra_pw
        self.campi["pw"].setText(self.voce.password or "" if self.mostra_pw else "••••••••••••"); self.b_mostra.setText("Nascondi" if self.mostra_pw else "Mostra")

    def copia(self, k):
        if not self.voce: return
        testo = self.voce.username if k == "utente" else self.voce.password
        md = QMimeData(); md.setText(testo or "")
        if k == "pw": md.setData("x-kde-passwordManagerHint", b"secret")   # cosi' non resta nella cronologia degli appunti
        QGuiApplication.clipboard().setMimeData(md); self.copiato = testo
        if k == "pw": self.t_appunti.start(); self.avviso_copia.setText("Password copiata: sparirà dagli appunti tra 20 secondi.")
        else: self.avviso_copia.setText("Utente copiato.")

    def pulisci_appunti(self):
        cb = QGuiApplication.clipboard()
        if self.copiato and cb.text() == self.copiato: cb.clear()
        self.copiato = None

    def salva(self):
        """Copia di sicurezza (.bak) e poi salvataggio. Se qualcosa va storto la cassaforte resta quella di prima."""
        try:
            shutil.copy2(FILE, FILE + ".bak"); self.kp.save(); os.chmod(FILE, 0o600)
            return True
        except Exception:
            QMessageBox.warning(self, "Cassaforte Password", "Non riesco a salvare. Le modifiche non sono state scritte: controlla lo spazio sul disco.")
            return False

    def nuova(self):
        d = Modifica(self)
        if d.exec() and self.kp and d.titolo.text().strip():
            e = self.kp.add_entry(self.kp.root_group, d.titolo.text().strip(), d.utente.text().strip(), d.pw.text(), url=d.sito.text().strip() or None, notes=d.note.toPlainText() or None)
            self.salva(); self.carica(scegli=e.uuid)

    def modifica(self):
        if not self.voce: return
        d = Modifica(self, self.voce)
        if d.exec() and self.kp and self.voce and d.titolo.text().strip():
            e = self.voce; e.save_history(); e.title = d.titolo.text().strip(); e.username = d.utente.text().strip(); e.password = d.pw.text()
            e.url = d.sito.text().strip(); e.notes = d.note.toPlainText()   # vuoto = "" (None fa chiudere il programma)
            self.salva(); self.carica(scegli=e.uuid)

    def elimina(self):
        if not self.voce: return
        if QMessageBox.question(self, "Elimina", "Vuoi eliminare «%s»?" % self.voce.title) == QMessageBox.StandardButton.Yes and self.kp and self.voce:
            self.kp.delete_entry(self.voce); self.voce = None; self.salva(); self.carica()

def main():
    os.umask(0o077)   # i file della cassaforte li legge solo l'utente
    app = QApplication(sys.argv); app.setApplicationName("Cassaforte Password"); app.setDesktopFileName("sofios-password")
    w = Password()
    foto = os.environ.get("SOFIOS_FOTO")
    if foto:
        pw = os.environ.get("SOFIOS_PW")
        w.show(); app.processEvents()
        if os.environ.get("SOFIOS_FOTO_SBLOCCO"): w.grab().save(os.environ["SOFIOS_FOTO_SBLOCCO"])
        if pw:
            w.s_pw.setText(pw); w.s_pw2.setText(pw); w.sblocca(); app.processEvents()
            if os.environ.get("SOFIOS_MOSTRA"): w.alterna_pw(); app.processEvents()
        w.grab().save(foto); return 0
    w.show(); return app.exec()
if __name__ == "__main__": sys.exit(main())
