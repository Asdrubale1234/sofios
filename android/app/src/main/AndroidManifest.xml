<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Rete e batteria nella barra SofiOS; luminosità e rotazione dal pannello (con il consenso dell'utente) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <!-- Per il comando «chiudi…» di Luma (chiude solo i programmi in secondo piano) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Cartella SofiOS comune a tutti i dispositivi (note, password, foto): serve l'accesso ai file -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- Internet: SOLO per dialogare con l'app di sincronizzazione (Syncthing-Fork) sul tablet stesso, all'indirizzo 127.0.0.1.
         Il codice rifiuta qualsiasi altro indirizzo; nessuna telemetria. Vedi docs/ECOSISTEMA.md -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Per vedere e aprire altre app (Fully, Impostazioni) -->
    <queries>
        <package android:name="de.ozerov.fully" />
        <package android:name="com.github.catfriend1.syncthingandroid" />
        <!-- app ufficiali degli assistenti online (facoltative): per sapere se sono installate -->
        <package android:name="com.anthropic.claude" /><package android:name="com.openai.chatgpt" />
        <package android:name="com.google.android.apps.bard" /><package android:name="com.microsoft.copilot" />
        <package android:name="com.deepseek.chat" /><package android:name="ai.mistral.chat" /><package android:name="ai.perplexity.app.android" />
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <!-- Per riconoscere Fully anche se il pacchetto avesse un nome diverso -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="SofiOS"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:networkSecurityConfig="@xml/rete_locale"
        android:allowBackup="false">

        <!-- Schermata iniziale: HOME + DEFAULT = Android la propone come "app di avvio" -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Note: come sul computer, un file di testo per nota -->
        <activity
            android:name=".NoteActivity"
            android:exported="false"
            android:label="Note"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".ImpostazioniActivity" android:exported="false" android:label="Impostazioni" />
        <activity android:name=".CassaforteActivity" android:exported="false" android:label="Cassaforte Password"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".FileActivity" android:exported="false" android:label="File" />
    </application>
</manifest>
