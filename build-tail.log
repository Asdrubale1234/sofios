cat: /etc/timezone: No such file or directory
-- Installatore: moduli (sequenza, avvio, utenti, fine) --
>> /etc/calamares/settings.conf
---
modules-search: [ local, /usr/lib/calamares/modules ]
oem-setup: false
disable-cancel: false
disable-cancel-during-exec: false
quit-at-end: false
sequence:
- show:
  - welcome
  - locale
  - keyboard
  - packagechooser@livelli
  - partition
  - users
  - summary
- exec:
  - partition
  - mount
  - unpackfs
  - luksbootkeyfile
  - dpkg-unsafe-io
  - sources-media
  - machineid
  - fstab
  - locale
  - keyboard
  - localecfg
  - users
  - displaymanager
  - networkcfg
  - hwclock
  - services-systemd
  - bootloader-config
  - grubcfg
  - bootloader
  - packages
  - contextualprocess
  - plymouthcfg
  - initramfscfg
  - initramfs
>> /etc/calamares/modules/bootloader.conf
---
efiBootLoader: "grub"
kernel: "/vmlinuz-linux"
img: "/initramfs-linux.img"
fallback: "/initramfs-linux-fallback.img"
timeout: "10"
grubInstall: "grub-install"
grubMkconfig: "grub-mkconfig"
grubCfg: "/boot/grub/grub.cfg"
grubProbe: "grub-probe"
efiBootMgr: "efibootmgr"
installEFIFallback: true 
>> /etc/calamares/modules/users.conf
---
userGroup:       users
defaultGroups:
    - cdrom
    - floppy
    - sudo
    - audio
    - dip
    - video
    - plugdev
    - netdev
    - lpadmin
    - scanner
    - bluetooth
autologinGroup:  autologin
sudoersGroup:    sudo
setRootPassword: false
passwordRequirements:
    nonempty: true
    minLength: -1  # Password at least this many characters
    maxLength: -1  # Password at most this many characters
    libpwquality:
        - minlen=0
        - minclass=0
doAutologin:     false
>> /etc/calamares/modules/displaymanager.conf
---
displaymanagers:
  - slim
  - sddm
  - lightdm
  - gdm
  - mdm
  - lxdm
  - kdm
basicSetup: false
sysconfigSetup: false
>> /etc/calamares/modules/finished.conf
---
restartNowEnabled: true
restartNowChecked: true
restartNowCommand: "systemctl -i reboot"
>> /etc/calamares/modules/welcome.conf
---
showSupportUrl: false
showKnownIssuesUrl: false
showReleaseNotesUrl: false
requirements:
  requiredStorage: 15
  requiredRam: 2.0
  internetCheckUrl: https://www.debian.org
  check:
    - storage
    - ram
    - power
  required:
    - storage
    - ram
>> /etc/calamares/modules/packages.conf
---
backend: apt
update_db: false
skip_if_no_internet: false
operations:
  - try_remove: [live-boot]
  - try_remove: [live-boot-doc]
  - try_remove: [live-config]
  - try_remove: [live-config-doc]
  - try_remove: [live-config-systemd]
  - try_remove: [live-tools]
  - try_remove: [live-task-localisation]
  - try_remove: [live-task-recommended]
  - try_remove: [calamares-settings-debian]
